原 MeetingRoom.tsx 中 ParticipantItem / VideoTile 子组件直接调用了 t()
但没在内部 useTranslation()，导致子组件空白崩溃。

整合路由后暴露了这个潜在的运行时 bug，统一修复。

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 src/pages/Meeting/MeetingRoom.tsx | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/pages/Meeting/MeetingRoom.tsx b/src/pages/Meeting/MeetingRoom.tsx
index 16f9753..a4dbb9a 100644
--- a/src/pages/Meeting/MeetingRoom.tsx
+++ b/src/pages/Meeting/MeetingRoom.tsx
@@ -1076,6 +1076,7 @@ interface ParticipantItemProps {
 }
 
 const ParticipantItem: React.FC<ParticipantItemProps> = ({ participant, isZh }) => {
+  const { t } = useTranslation();
   return (
     <div className={`participant-item ${participant.status}`}>
       <Avatar
@@ -1119,6 +1120,7 @@ const VideoTile: React.FC<VideoTileProps> = ({
   small,
   cameraStream,
 }) => {
+  const { t } = useTranslation();
   const showCamera = isCurrentUser && !participant.isVideoOff && cameraStream;
   const videoRef = useRef<HTMLVideoElement | null>(null);
 
