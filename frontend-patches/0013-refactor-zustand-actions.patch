+/**
+ * Contacts store 的 actions 集合
+ *
+ * 为什么 actions 要独立成文件？
+ *   1. 引用稳定性：actions 在模块加载时创建一次，永远冻结，引用不变
+ *   2. 避免 zustand selector 订阅函数引用导致的无限重渲染
+ *   3. 避免循环依赖：actions 调用 useContactsStore.getState()/setState()，必须先 import store
+ *
+ * 用法：store 中直接复用这些 actions 的引用，不在 create 回调内重新包装
+ */
+
+import type { ChatMessage } from '@/types/contacts';
+import { MOCK_EMPLOYEES } from '@/mock/employees';
+import { generateId } from '@/utils/format';
+import { useContactsStore } from './contactsStore';
+
+export const contactsActions = {
+  bootstrap: (): void => {
+    if (useContactsStore.getState().employees.length === 0) {
+      useContactsStore.setState({ employees: MOCK_EMPLOYEES });
+    }
+  },
+
+  findByUsername: (username: string) => {
+    return useContactsStore.getState().employees.find((e) => e.username === username);
+  },
+
+  getMessages: (userId: string, peerId: string): ChatMessage[] => {
+    return useContactsStore.getState().messagesByUser[userId]?.[peerId] ?? [];
+  },
+
+  sendMessage: (userId: string, peerId: string, content: string): ChatMessage | null => {
+    const text = content.trim();
+    if (!text) return null;
+    const msg: ChatMessage = {
+      id: generateId('msg'),
+      fromId: userId,
+      toId: peerId,
+      content: text,
+      timestamp: new Date().toISOString(),
+      type: 'text',
+    };
+    useContactsStore.setState((state) => {
+      const userBucket = state.messagesByUser[userId] ?? {};
+      const peerBucket = userBucket[peerId] ?? [];
+      return {
+        messagesByUser: {
+          ...state.messagesByUser,
+          [userId]: {
+            ...userBucket,
+            [peerId]: [...peerBucket, msg],
+          },
+        },
+      };
+    });
+    return msg;
+  },
+
+  markRead: (userId: string, peerId: string): void => {
+    useContactsStore.setState((state) => {
+      const userUnread = { ...(state.unread[userId] ?? {}) };
+      if (userUnread[peerId]) {
+        delete userUnread[peerId];
+      }
+      return {
+        unread: { ...state.unread, [userId]: userUnread },
+      };
+    });
+  },
+
+  getUnread: (userId: string, peerId: string): number => {
+    return useContactsStore.getState().unread[userId]?.[peerId] ?? 0;
+  },
+};
+
+// 冻结 actions 对象，防止意外修改引用
+Object.freeze(contactsActions);
