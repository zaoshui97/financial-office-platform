+      render: () => <PostMeetingReport />,
+    },
+  ];
+
+  const visibleTabs = tabs.filter((t) => t.show);
+  const currentTab = tabs.find((t) => t.key === activeTab);
+
+  return (
+    <div style={{ padding: 20, background: '#F7F9FC', minHeight: '100%' }}>
+      {/* Header */}
+      <Card
+        size="small"
+        style={{
+          marginBottom: 16,
+          background: 'linear-gradient(135deg, #0F2B5B, #1E40AF)',
+          border: 'none',
+        }}
+        styles={{ body: { padding: '16px 20px' } }}
+      >
+        <Space size={16} align="center" style={{ width: '100%', justifyContent: 'space-between' }}>
+          <Space direction="vertical" size={0}>
+            <Space size={8}>
+              <CalendarOutlined style={{ fontSize: 24, color: '#fff' }} />
+              <Title level={4} style={{ margin: 0, color: '#fff' }}>
+                {zh ? '会议中心' : 'Meeting Center'}
+              </Title>
+              <Tag color="gold" style={{ border: 'none', background: 'rgba(255,255,255,0.2)', color: '#fff' }}>
+                {zh ? '5 大场景合一' : '5-in-1'}
+              </Tag>
+            </Space>
+            <Text style={{ color: 'rgba(255,255,255,0.75)', fontSize: 12 }}>
+              {zh
+                ? '会议从预约、详情、实时会议、彩排到报告生成，全在一个页面'
+                : 'Meeting lifecycle: schedule → detail → live → rehearsal → report, all in one page'}
+            </Text>
+          </Space>
+        </Space>
+      </Card>
+
+      {/* Tabs */}
+      <Card styles={{ body: { padding: '0 0 12px 0' } }} style={{ background: '#fff' }}>
+        <Tabs
+          activeKey={activeTab}
+          onChange={handleTabChange}
+          items={visibleTabs.map((t) => ({ key: t.key, label: t.label }))}
+          size="large"
+          tabBarStyle={{
+            margin: 0,
+            paddingLeft: 20,
+            borderBottom: '1px solid #F0F0F0',
+          }}
+        />
+
+        <div style={{ padding: '0 16px' }}>
+          <Suspense
+            fallback={
+              <div style={{ padding: 60, textAlign: 'center' }}>
+                <Spin size="large" tip={zh ? '加载中…' : 'Loading…'} />
+              </div>
+            }
+          >
+            {currentTab?.render()}
+          </Suspense>
+        </div>
+      </Card>
+
+      <Alert
+        type="info"
+        showIcon
+        message={zh ? '💡 会议中心整合说明' : '💡 About Meeting Center'}
+        description={
+          <Paragraph style={{ marginBottom: 0, fontSize: 12 }}>
+            {zh
+              ? '把原本 5 个会议页面（列表 / 详情 / 实时会议室 / 彩排 / 报告）合并为一个入口。Tab 切换保持会议 ID（id 参数），无需重复选择。'
+              : 'Consolidates 5 meeting pages (List / Detail / Live / Rehearsal / Report) into one entry. Tab switches preserve the meeting ID via URL params.'}
+          </Paragraph>
+        }
+        style={{ marginTop: 12 }}
+        closable
+      />
+    </div>
+  );
+};
+
+export default MeetingHub;
