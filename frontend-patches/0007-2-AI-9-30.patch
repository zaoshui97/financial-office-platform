+                gap: 16,
+              }}
+            >
+              <SafetyCertificateOutlined style={{ fontSize: 64, color: '#D1D5DB' }} />
+              <Text type="secondary" style={{ fontSize: 16 }}>
+                {zh ? '在左侧输入文本，点击"启动合规沙箱"开始检测' : 'Enter text on the left, click "Run Compliance Check"'}
+              </Text>
+              <Text type="secondary" style={{ fontSize: 12 }}>
+                {zh ? '检测耗时约 1-2 秒，覆盖 9 大类 47 条金融合规规则' : 'Takes ~1-2s · Covers 9 categories · 47 compliance rules'}
+              </Text>
+            </Card>
+          )}
+
+          {(runState === 'running') && (
+            <Card style={{ minHeight: 400 }}>
+              <div style={{ textAlign: 'center', padding: '60px 0' }}>
+                <Spin size="large" tip={zh ? 'AI 沙箱正在分析文本…' : 'AI sandbox analyzing…'} />
+                <div style={{ marginTop: 16 }}>
+                  <Text type="secondary">{zh ? '正在匹配 47 条合规规则…' : 'Matching 47 compliance rules…'}</Text>
+                </div>
+              </div>
+            </Card>
+          )}
+
+          {runState === 'done' && result && (
+            <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
+              {/* 阻断告警 */}
+              {result.blocked && (
+                <Alert
+                  type="error"
+                  showIcon
+                  icon={<CloseCircleOutlined />}
+                  message={
+                    <Space>
+                      <Text strong style={{ color: '#991B1B' }}>
+                        {zh ? '⚠️ 检测到阻断级违规' : '⚠️ Block-level violations detected'}
+                      </Text>
+                    </Space>
+                  }
+                  description={
+                    zh
+                      ? `命中 ${result.issues.filter(i => i.severity === 'block').length} 条阻断规则，内容必须修改后才能通过审核`
+                      : `${result.issues.filter(i => i.severity === 'block').length} blocking rules hit — content must be revised before submission`
+                  }
+                  style={{ background: '#FEF2F2', borderColor: '#FCA5A5' }}
+                />
+              )}
+
+              {/* 通过提示 */}
+              {result.passed && !result.blocked && (
+                <Alert
+                  type="success"
+                  showIcon
+                  icon={<CheckCircleOutlined />}
+                  message={zh ? '✅ 合规检查通过' : '✅ Compliance Check Passed'}
+                  description={
+                    zh
+                      ? `评分 ${result.score.toFixed(1)}/5 · 命中 0 条阻断规则 · 耗时 ${result.durationMs}ms`
+                      : `Score ${result.score.toFixed(1)}/5 · 0 blocking rules · ${result.durationMs}ms`
+                  }
+                  style={{ background: '#ECFDF5', borderColor: '#A7F3D0' }}
+                />
+              )}
+
+              {/* 评分 + 统计 */}
+              <Card>
+                <Row gutter={24} align="middle">
+                  <Col xs={24} sm={8} style={{ textAlign: 'center' }}>
+                    <ScoreRing score={result.score} size={120} />
+                    <div style={{ marginTop: 8 }}>
+                      <Tag
+                        color={result.blocked ? 'error' : result.passed ? 'success' : 'warning'}
+                        icon={result.blocked ? <CloseCircleOutlined /> : result.passed ? <CheckCircleOutlined /> : <WarningOutlined />}
+                        style={{ fontSize: 13 }}
+                      >
+                        {result.blocked
+                          ? (zh ? '阻断' : 'Blocked')
+                          : result.passed
+                          ? (zh ? '通过' : 'Passed')
+                          : (zh ? '警告' : 'Warning')}
+                      </Tag>
+                    </div>
+                  </Col>
+                  <Col xs={24} sm={16}>
+                    <Row gutter={[8, 8]}>
+                      <Col span={8}>
+                        <div style={{ textAlign: 'center' }}>
+                          <Title level={3} style={{ margin: 0, color: '#DC2626' }}>{result.issues.length}</Title>
+                          <Text type="secondary" style={{ fontSize: 12 }}>{zh ? '风险项' : 'Issues'}</Text>
+                        </div>
+                      </Col>
+                      <Col span={8}>
+                        <div style={{ textAlign: 'center' }}>
+                          <Title level={3} style={{ margin: 0, color: '#EF4444' }}>{result.totalHits}</Title>
+                          <Text type="secondary" style={{ fontSize: 12 }}>{zh ? '命中次数' : 'Hits'}</Text>
+                        </div>
+                      </Col>
+                      <Col span={8}>
+                        <div style={{ textAlign: 'center' }}>
+                          <Title level={3} style={{ margin: 0, color: '#3B82F6' }}>{result.regulations.length}</Title>
+                          <Text type="secondary" style={{ fontSize: 12 }}>{zh ? '关联法规' : 'Regulations'}</Text>
+                        </div>
+                      </Col>
+                      <Col span={24}>
+                        <Text type="secondary" style={{ fontSize: 11 }}>
+                          🏃 {zh ? '检测耗时' : 'Duration'}: {result.durationMs}ms · {zh ? '规则库版本' : 'Rules version'}: v2024.10
+                        </Text>
+                      </Col>
+                    </Row>
+                  </Col>
+                </Row>
+              </Card>
+
+              {/* Tab 区域 */}
+              <Tabs
+                activeKey={activeTab}
+                onChange={setActiveTab}
+                items={[
+                  {
+                    key: 'result',
+                    label: (
+                      <span>
+                        <WarningOutlined />
+                        {zh ? '风险详情' : 'Risk Details'} ({result.issues.length})
+                      </span>
+                    ),
+                    children: (
+                      <Card size="small" style={{ maxHeight: 480, overflow: 'auto' }}>
+                        {result.issues.length === 0 ? (
+                          <div style={{ textAlign: 'center', padding: 24 }}>
+                            <CheckCircleOutlined style={{ fontSize: 32, color: '#22A775' }} />
+                            <div style={{ marginTop: 8 }}>{zh ? '未发现合规风险' : 'No compliance risks found'}</div>
+                          </div>
+                        ) : (
+                          <List
+                            size="small"
+                            dataSource={result.issues}
+                            renderItem={(issue) => {
+                              const meta = CATEGORY_META[issue.category];
+                              return (
+                                <List.Item
+                                  style={{
+                                    borderLeft: `4px solid ${severityColor[issue.severity]}`,
+                                    paddingLeft: 12,
+                                    marginBottom: 8,
+                                  }}
+                                >
+                                  <div style={{ width: '100%' }}>
+                                    <Space size={6} wrap>
+                                      <Tag color={severityColor[issue.severity]}>
+                                        {severityLabel[issue.severity]}
+                                      </Tag>
+                                      <Tag style={{ background: `${meta.color}22`, borderColor: meta.color, color: meta.color }}>
+                                        {meta.icon} {zh ? meta.name : meta.nameEn}
+                                      </Tag>
+                                      <Text strong style={{ fontSize: 13 }}>{issue.ruleName}</Text>
+                                    </Space>
+                                    {issue.snippets.length > 0 && (
+                                      <div style={{ marginTop: 4, marginLeft: 4, fontSize: 12, color: '#6B7280' }}>
+                                        💬 {issue.snippets[0]}
+                                      </div>
+                                    )}
+                                    <div style={{ marginTop: 4, fontSize: 12, color: '#059669' }}>
+                                      💡 {issue.suggestion}
+                                    </div>
+                                    {issue.regulations.length > 0 && (
+                                      <div style={{ marginTop: 4 }}>
+                                        {issue.regulations.slice(0, 2).map((reg) => (
+                                          <Tag
+                                            key={reg.id}
+                                            size="small"
+                                            icon={<BookOutlined />}
+                                            style={{ cursor: 'pointer', marginBottom: 4 }}
+                                            onClick={() => {
+                                              setSelectedRegulation(reg);
+                                              setRegModalOpen(true);
+                                            }}
+                                          >
+                                            {reg.shortName} {reg.article}
+                                          </Tag>
+                                        ))}
+                                      </div>
+                                    )}
+                                  </div>
+                                </List.Item>
+                              );
+                            }}
+                          />
+                        )}
+                      </Card>
+                    ),
+                  },
+                  {
+                    key: 'highlight',
+                    label: (
+                      <span>
+                        <FileTextOutlined />
+                        {zh ? '高亮文本' : 'Highlighted Text'}
+                      </span>
+                    ),
+                    children: (
+                      <Card size="small" style={{ maxHeight: 480, overflow: 'auto' }}>
+                        <RuleHighlight text={text} hitSpans={result.hitSpans} />
+                      </Card>
+                    ),
+                  },
+                  {
+                    key: 'rewrite',
+                    label: (
+                      <span>
+                        <ReloadOutlined />
+                        {zh ? '改写建议' : 'Rewrite Suggestions'}
+                      </span>
+                    ),
+                    children: (
+                      <Card size="small" style={{ maxHeight: 480 }}>
+                        <div style={{ whiteSpace: 'pre-wrap', fontSize: 13, lineHeight: 1.8 }}>
