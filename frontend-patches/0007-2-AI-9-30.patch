+  | 'anti_money_laundry' // 4. 反洗钱可疑
+  | 'unfair_competition' // 5. 反不正当竞争
+  | 'customer_suitability' // 6. 客户适当性
+  | 'conflict_interest'  // 7. 利益冲突
+  | 'related_transaction' // 8. 关联交易
+  | 'disclosure_violation'; // 9. 信息披露违规
