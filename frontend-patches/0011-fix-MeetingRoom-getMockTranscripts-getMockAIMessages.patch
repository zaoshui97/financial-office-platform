模块顶层 mock 函数使用了 useTranslation() 返回的 t 函数，
但 hook 只能在组件内部调用，导致 ReferenceError: t is not defined。

修复：改用模块级 i18n.t 调用。

复现路径：/meeting?tab=room&id=1（之前整合路由后被暴露）

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 src/pages/Meeting/MeetingRoom.tsx | 74 ++++++++++++++++---------------
 1 file changed, 39 insertions(+), 35 deletions(-)

diff --git a/src/pages/Meeting/MeetingRoom.tsx b/src/pages/Meeting/MeetingRoom.tsx
index a4dbb9a..31ba548 100644
--- a/src/pages/Meeting/MeetingRoom.tsx
+++ b/src/pages/Meeting/MeetingRoom.tsx
@@ -144,46 +144,50 @@ const buildOtherParticipantsFromContacts = (
   }));
 };
 
-const getMockTranscripts = (isZh: boolean, hostName: string): TranscriptItem[] => [
-  {
-    id: 1,
-    speaker: hostName || (t('meeting.host')),
-    speakerId: 'current-user',
-    content: t('auto.65'),
-    time: '14:00:01',
-    type: 'transcript',
-  },
-  {
-    id: 2,
-    speaker: t('auto.22'),
-    speakerId: 'user-002',
-    content: t('auto.64'),
-    time: '14:00:25',
-    type: 'transcript',
-  },
-  {
-    id: 3,
-    speaker: t('auto.21'),
-    speakerId: 'user-003',
-    content: t('auto.63'),
-    time: '14:01:15',
-    type: 'transcript',
-  },
-  {
-    id: 4,
-    speaker: hostName || (t('meeting.host')),
-    speakerId: 'current-user',
-    content: t('auto.62'),
-    time: '14:01:30',
-    type: 'transcript',
-  },
-];
+const getMockTranscripts = (isZh: boolean, hostName: string): TranscriptItem[] => {
+  // 模块级不能使用 hook 的 t，改用 i18n.t
+  const tKey = (key: string) => i18n.t(key);
+  return [
+    {
+      id: 1,
+      speaker: hostName || (tKey('meeting.host')),
+      speakerId: 'current-user',
+      content: tKey('auto.65'),
+      time: '14:00:01',
+      type: 'transcript',
+    },
+    {
+      id: 2,
+      speaker: tKey('auto.22'),
+      speakerId: 'user-002',
+      content: tKey('auto.64'),
+      time: '14:00:25',
+      type: 'transcript',
+    },
+    {
+      id: 3,
+      speaker: tKey('auto.21'),
+      speakerId: 'user-003',
+      content: tKey('auto.63'),
+      time: '14:01:15',
+      type: 'transcript',
+    },
+    {
+      id: 4,
+      speaker: hostName || (tKey('meeting.host')),
+      speakerId: 'current-user',
+      content: tKey('auto.62'),
+      time: '14:01:30',
+      type: 'transcript',
+    },
+  ];
+};
 
 const getMockAIMessages = (isZh: boolean): AIMessage[] => [
   {
     id: 'ai-001',
     role: 'assistant',
-    content: t('auto.61'),
+    content: i18n.t('auto.61'),
     timestamp: new Date().toISOString(),
   },
 ];
