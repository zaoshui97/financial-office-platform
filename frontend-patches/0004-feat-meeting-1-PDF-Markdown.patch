diff --git a/src/pages/Meeting/PostMeetingReport.tsx b/src/pages/Meeting/PostMeetingReport.tsx
new file mode 100644
index 0000000..3dd6753
--- /dev/null
+++ b/src/pages/Meeting/PostMeetingReport.tsx
@@ -0,0 +1,257 @@
+/**
+ * 独立会议报告页
+ * 路径: /meeting/:id/report
+ * 设计目标: 评委演示时一眼看到"会后自动派单 + 可导出"的完整闭环
+ */
+
+import React, { useEffect, useState, useRef } from 'react';
+import { useParams, useNavigate } from 'react-router-dom';
+import {
+  Card,
+  Button,
+  Space,
+  Typography,
+  Result,
+  Spin,
+  Breadcrumb,
+  Tag,
+  Statistic,
+  Row,
+  Col,
+  Divider,
+} from 'antd';
+import {
+  ArrowLeftOutlined,
+  RocketOutlined,
+  ReloadOutlined,
+  CalendarOutlined,
+  TeamOutlined,
+  ClockCircleOutlined,
+} from '@ant-design/icons';
+import { useTranslation } from 'react-i18next';
+import { ReportSummary } from '@/components/Meeting/PostMeeting/ReportSummary';
+import { ActionDispatchPanel } from '@/components/Meeting/PostMeeting/ActionDispatchPanel';
+import { ExportToolbar } from '@/components/Meeting/PostMeeting/ExportToolbar';
+import {
+  generateReport,
+  closeMeeting,
+} from '@/services/postMeetingService';
+import { useBlackboard } from '@/services/useMultiAgent';
+import { agentBus } from '@/services/multiAgentBus';
+import type {
+  GetReportResponse,
+  DispatchActionResponse,
+} from '@/services/meetingApiContract';
+
+const { Title, Text, Paragraph } = Typography;
+
+const PostMeetingReport: React.FC = () => {
+  const { t } = useTranslation();
+  const { id } = useParams<{ id: string }>();
+  const navigate = useNavigate();
+  const bb = useBlackboard();
+  const [report, setReport] = useState<GetReportResponse['data'] | null>(null);
+  const [dispatch, setDispatch] = useState<DispatchActionResponse['data'] | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [dispatching, setDispatching] = useState(false);
+  const reportRef = useRef<HTMLDivElement>(null);
+
+  const loadReport = async () => {
+    if (!id) return;
+    setLoading(true);
+    try {
+      const r = await generateReport(id);
+      setReport(r);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    loadReport();
+  }, [id]);
+
+  // 监听自动派单事件
+  useEffect(() => {
+    if (!id) return;
+    return agentBus.subscribe('meeting:state', (evt) => {
+      if (evt.meetingId === id && (evt.payload as any)?.dispatchBatchId) {
+        setDispatch(evt.payload as any);
+      }
+    });
+  }, [id]);
+
+  // 自动派单：进入页面且 Blackboard 有待办时自动触发
+  useEffect(() => {
+    if (!report || !id) return;
+    if (dispatch) return;
+    if (bb.actions.length === 0) return;
+    if (bb.meetingId !== id) return;
+
+    setDispatching(true);
+    closeMeeting(id, bb)
+      .then((result) => {
+        setDispatch(result.dispatch);
+      })
+      .finally(() => setDispatching(false));
+  }, [report, id, bb.actions.length, bb.meetingId, dispatch]);
+
+  const handleBack = () => {
+    if (id) navigate(`/meeting/${id}`);
+  };
+
+  if (loading && !report) {
+    return (
+      <div style={{ padding: 48, textAlign: 'center' }}>
+        <Spin size="large" tip={t('postMeeting.generating')} />
+      </div>
+    );
+  }
+
+  if (!report) {
+    return (
+      <Result
+        status="warning"
+        title={t('postMeeting.reportNotFound')}
+        extra={
+          <Button type="primary" onClick={handleBack}>
+            {t('common.back')}
+          </Button>
+        }
+      />
+    );
+  }
+
+  return (
+    <div ref={reportRef} style={{ padding: 24, maxWidth: 1200, margin: '0 auto' }}>
+      {/* 面包屑 */}
+      <Breadcrumb
+        style={{ marginBottom: 16 }}
+        items={[
+          { title: <a onClick={() => navigate('/meeting')}>{t('meeting.title')}</a> },
+          { title: <a onClick={handleBack}>{report.meetingTitle}</a> },
+          { title: t('postMeeting.reportTitle') },
+        ]}
+      />
+
+      {/* 顶部标题区 */}
+      <Card style={{ marginBottom: 16 }}>
+        <Space direction="vertical" size={8} style={{ width: '100%' }}>
+          <Space>
+            <Button
+              type="text"
+              icon={<ArrowLeftOutlined />}
+              onClick={handleBack}
+            />
+            <Title level={3} style={{ margin: 0 }}>
+              {report.meetingTitle}
+            </Title>
+            <Tag color="success" icon={<RocketOutlined />}>
+              {t('postMeeting.autoGenerated')}
+            </Tag>
+          </Space>
+
+          <Space size={24} wrap>
+            <Space size={4}>
+              <CalendarOutlined />
+              <Text type="secondary">{report.startedAt}</Text>
+            </Space>
+            <Space size={4}>
+              <ClockCircleOutlined />
+              <Text type="secondary">
+                {Math.floor(report.durationSec / 60)} {t('postMeeting.minutes')}
+              </Text>
+            </Space>
+            <Space size={4}>
+              <TeamOutlined />
+              <Text type="secondary">
+                {report.participants.length} {t('postMeeting.people')}
+              </Text>
+            </Space>
+          </Space>
+
+          <Divider style={{ margin: '12px 0' }} />
+
+          {/* 核心统计 */}
+          <Row gutter={16}>
+            <Col span={6}>
+              <Statistic
+                title={t('postMeeting.decisions')}
+                value={report.sections.decisions.length}
+                valueStyle={{ color: '#10B981' }}
+              />
+            </Col>
+            <Col span={6}>
+              <Statistic
+                title={t('postMeeting.statTotal')}
+                value={report.sections.actions.length}
+                valueStyle={{ color: '#0F2B5B' }}
+              />
+            </Col>
+            <Col span={6}>
+              <Statistic
+                title={t('postMeeting.risks')}
+                value={report.sections.risks.length}
+                valueStyle={{ color: '#EF4444' }}
+              />
+            </Col>
+            <Col span={6}>
+              <Statistic
+                title={t('postMeeting.topics')}
+                value={report.sections.topics.length}
+                valueStyle={{ color: '#6366F1' }}
+              />
+            </Col>
+          </Row>
+
+          <Divider style={{ margin: '12px 0' }} />
+
+          {/* 操作按钮 */}
+          <Space wrap>
+            <ExportToolbar report={report} />
+            <Button
+              icon={<ReloadOutlined />}
+              onClick={loadReport}
+              loading={loading}
+            >
+              {t('common.refresh')}
+            </Button>
+            {!dispatch && report.sections.actions.length > 0 && (
+              <Button
+                type="primary"
+                icon={<RocketOutlined />}
+                onClick={async () => {
+                  setDispatching(true);
+                  try {
+                    const r = await closeMeeting(id!, bb);
+                    setDispatch(r.dispatch);
+                  } finally {
+                    setDispatching(false);
+                  }
+                }}
+                loading={dispatching}
+              >
+                {t('postMeeting.manualDispatch')}
+              </Button>
+            )}
+          </Space>
+        </Space>
+      </Card>
+
+      {/* 两栏布局：报告 + 派单 */}
+      <Row gutter={16}>
+        <Col xs={24} lg={14}>
+          <ReportSummary report={report} />
+        </Col>
+        <Col xs={24} lg={10}>
+          <ActionDispatchPanel
+            meetingId={id!}
+            initialDispatch={dispatch || undefined}
+          />
+        </Col>
+      </Row>
+    </div>
+  );
+};
+
+export default PostMeetingReport;
