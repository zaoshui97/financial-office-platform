+++ b/src/components/Meeting/PostMeeting/ReportSummary.tsx
@@ -0,0 +1,128 @@
+/**
+ * ReportSummary — 5 段结构化报告渲染
+ * 纯展示组件，所有数据从 props 传入
+ */
+
+import React from 'react';
+import { Card, Empty, Tag, Space, Typography, Divider } from 'antd';
+import {
+  BulbOutlined,
+  CheckCircleOutlined,
+  WarningOutlined,
+  ProfileOutlined,
+  TagsOutlined,
+} from '@ant-design/icons';
+import { useTranslation } from 'react-i18next';
+import type { GetReportResponse } from '@/services/meetingApiContract';
+
+const { Text, Title } = Typography;
+
+export interface ReportSummaryProps {
+  report: GetReportResponse['data'];
+}
+
+export const ReportSummary: React.FC<ReportSummaryProps> = ({ report }) => {
+  const { t } = useTranslation();
+
+  return (
+    <div className="report-summary">
+      {/* 摘要 */}
+      <Card
+        size="small"
+        title={
+          <Space>
+            <ProfileOutlined style={{ color: '#0F2B5B' }} />
+            {t('postMeeting.summary')}
+          </Space>
+        }
+        style={{ marginBottom: 12 }}
+      >
+        {report.summary ? (
+          <pre style={{ whiteSpace: 'pre-wrap', fontFamily: 'inherit', margin: 0, fontSize: 13 }}>
+            {report.summary}
+          </pre>
+        ) : (
+          <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={t('postMeeting.noSummary')} />
+        )}
+      </Card>
+
+      {/* 关键决策 */}
+      <Card
+        size="small"
+        title={
+          <Space>
+            <CheckCircleOutlined style={{ color: '#10B981' }} />
+            {t('postMeeting.decisions')} ({report.sections.decisions.length})
+          </Space>
+        }
+        style={{ marginBottom: 12 }}
+      >
+        {report.sections.decisions.length === 0 ? (
+          <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={t('postMeeting.noDecisions')} />
+        ) : (
+          report.sections.decisions.map((d, i) => (
+            <div
+              key={i}
+              style={{
+                padding: '10px 0',
+                borderBottom: i < report.sections.decisions.length - 1 ? '1px dashed #E5E7EB' : 'none',
+              }}
+            >
+              <Space>
+                <Tag color="green">{i + 1}</Tag>
+                <Text strong>{d.topic}</Text>
+                <Tag color="blue">{(d.confidence * 100).toFixed(0)}%</Tag>
+              </Space>
+              <div style={{ marginLeft: 28, marginTop: 4, color: '#374151' }}>{d.decision}</div>
+              <div style={{ marginLeft: 28, marginTop: 2, fontSize: 12, color: '#9CA3AF' }}>
+                {t('postMeeting.owner')}: {d.owner || '-'}
+              </div>
+            </div>
+          ))
+        )}
+      </Card>
+
+      {/* 风险信号 */}
+      {report.sections.risks.length > 0 && (
+        <Card
+          size="small"
+          title={
+            <Space>
+              <WarningOutlined style={{ color: '#EF4444' }} />
+              {t('postMeeting.risks')} ({report.sections.risks.length})
+            </Space>
+          }
+          style={{ marginBottom: 12, borderColor: '#FCA5A5' }}
+        >
+          {report.sections.risks.map((r, i) => (
+            <div key={i} style={{ padding: '6px 0', color: '#B91C1C' }}>
+              <WarningOutlined style={{ marginRight: 8 }} />
+              {r}
+            </div>
+          ))}
+        </Card>
+      )}
+
+      {/* 议题 */}
+      {report.sections.topics.length > 0 && (
+        <Card
+          size="small"
+          title={
+            <Space>
+              <TagsOutlined style={{ color: '#6366F1' }} />
+              {t('postMeeting.topics')} ({report.sections.topics.length})
+            </Space>
+          }
+        >
+          {report.sections.topics.map((t, i) => (
+            <Tag key={i} color="purple" style={{ marginBottom: 4 }}>
+              #{t}
+            </Tag>
+          ))}
+        </Card>
+      )}
+    </div>
+  );
+};
+
+export default ReportSummary;
