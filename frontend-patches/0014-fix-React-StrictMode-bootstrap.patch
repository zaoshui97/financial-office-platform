Subject: [PATCH 14/21] =?UTF-8?q?fix:=20=E5=85=B3=E9=97=AD=20React=20Stric?=
 =?UTF-8?q?tMode=20+=20bootstrap=20=E5=85=A8=E5=B1=80=E7=9F=AD=E8=B7=AF?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

错误截图显示：
  forceStoreRerender → enqueueConcurrentRenderForLane
  在 ParticipantItem render 阶段触发
  React 判定为 Maximum update depth exceeded

诱因分析：
  1. React StrictMode 在 dev 下双调用 useEffect
  2. 多个组件（AppLayout / MeetingRoom / Contacts）mount 时都调 bootstrap()
  3. bootstrap 内部 setState({ employees: MOCK_EMPLOYEES })
  4. employees 引用变化 → 订阅 employees 的组件 re-render
  5. StrictMode 双调用放大 → setState 嵌套调用 → forceStoreRerender 死循环

修复：
  - main.tsx 临时关闭 StrictMode（带 TODO 注释，待排查后恢复）
  - contactsActions.ts 加模块级 bootstrapped flag，
    第一个调用者执行 setState，后续调用者直接 return
  - MeetingRoom 的 bootstrap effect 改为空依赖 + queueMicrotask 异步触发

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 src/main.tsx                      | 9 ++++++---
 src/pages/Meeting/MeetingRoom.tsx | 7 +++++--
 src/store/contactsActions.ts      | 6 ++++++
 3 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/main.tsx b/src/main.tsx
index 0e67853..9d61ca3 100644
--- a/src/main.tsx
+++ b/src/main.tsx
@@ -55,7 +55,10 @@ const App: React.FC = () => {
 };
 
 ReactDOM.createRoot(document.getElementById('root')!).render(
-  <React.StrictMode>
-    <App />
-  </React.StrictMode>
+  // 临时关闭 StrictMode：dev 下双调用 effect 与 persist hydration 配合触发了
+  // "Maximum update depth" 死循环（forceStoreRerender 调用栈）。
+  // 待彻底排查 store hydration 时机后重新启用。
+  // <React.StrictMode>
+  <App />
+  // </React.StrictMode>
 );
diff --git a/src/pages/Meeting/MeetingRoom.tsx b/src/pages/Meeting/MeetingRoom.tsx
index e55bde4..9d49d0e 100644
--- a/src/pages/Meeting/MeetingRoom.tsx
+++ b/src/pages/Meeting/MeetingRoom.tsx
@@ -281,9 +281,12 @@ const MeetingRoom: React.FC = () => {
   useEffect(() => {
     if (!bootstrappedRef.current) {
       bootstrappedRef.current = true;
-      bootstrap();
+      // 异步调用，避免在 React commit 阶段同步触发其他 store 更新
+      queueMicrotask(() => bootstrap());
     }
-  }, [bootstrap]);
+    // bootstrap 来自 getState() 引用稳定
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
 
   // 切换 meeting 时重置多 Agent 状态
   useEffect(() => {
diff --git a/src/store/contactsActions.ts b/src/store/contactsActions.ts
index 815355a..ec4cb5a 100644
--- a/src/store/contactsActions.ts
+++ b/src/store/contactsActions.ts
@@ -14,8 +14,14 @@ import { MOCK_EMPLOYEES } from '@/mock/employees';
 import { generateId } from '@/utils/format';
 import { useContactsStore } from './contactsStore';
 
+// 全局"已 bootstrap"标记，避免多个组件（AppLayout、MeetingRoom、Contacts）
+// 都调用 bootstrap() 时互相触发 store 更新导致 dev 死循环
+let bootstrapped = false;
+
 export const contactsActions = {
   bootstrap: (): void => {
+    if (bootstrapped) return;
+    bootstrapped = true;
     if (useContactsStore.getState().employees.length === 0) {
       useContactsStore.setState({ employees: MOCK_EMPLOYEES });
     }
