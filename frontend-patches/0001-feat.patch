+  const tabItems = [
+    { key: 'all', label: t('common.all') },
+    { key: 'unread', label: <span>{t('notification.unread')} <Badge count={unreadCount} size="small" /></span> },
+    { key: 'urgent', label: t('notification.urgent') },
+    { key: 'meeting', label: t('notification.meeting') },
+    { key: 'ai', label: t('notification.ai') },
+    { key: 'system', label: t('notification.system') },
+  ];
+
+  return (
+    <div className="notifications-page">
+      <div className="notifications-header">
+        <Space>
+          <BellOutlined style={{ fontSize: 24, color: 'var(--color-primary)' }} />
+          <Title level={4} style={{ margin: 0 }}>{t('topbar.notifications')}</Title>
+          {unreadCount > 0 && (
+            <Tag color="red">{unreadCount} {t('notification.unreadCount')}</Tag>
+          )}
+        </Space>
+        <Space>
+          <Button
+            type="link"
+            icon={<CheckOutlined />}
+            onClick={markAllAsRead}
+            disabled={unreadCount === 0}
+          >
+            {t('notification.markAllRead')}
+          </Button>
+          <Button
+            type="link"
+            danger
+            icon={<DeleteOutlined />}
+            onClick={clearAll}
+            disabled={notifications.length === 0}
+          >
+            {t('notification.clearAll')}
+          </Button>
+        </Space>
+      </div>
+
+      <Card className="notifications-content">
+        <Tabs
+          selectedKey={activeTab}
+          onChange={setActiveTab}
+          items={tabItems}
+        />
+
+        {filteredNotifications.length === 0 ? (
+          <Empty
+            image={Empty.PRESENTED_IMAGE_SIMPLE}
+            description={
+              <span style={{ color: 'var(--color-text-hint)' }}>
+                {activeTab === 'unread' ? t('notification.noUnread') : t('common.noData')}
+              </span>
+            }
+          />
+        ) : (
+          <div className="notification-list">
+            {filteredNotifications.map((item) => (
+              <div
+                key={item.id}
+                className={`notification-item ${!item.read ? 'unread' : ''}`}
+                onClick={() => markAsRead(item.id)}
+              >
+                <div className="notification-icon">{getTypeIcon(item.type)}</div>
+                <div className="notification-body">
+                  <div className="notification-header">
+                    <Space>
+                      <Text strong>{item.title}</Text>
+                      {getTypeTag(item.type)}
+                    </Space>
+                    <Text type="secondary" className="notification-time">
+                      {getTimeAgo(item.timestamp)}
+                    </Text>
+                  </div>
+                  <Text className="notification-content">{item.content}</Text>
+                  {item.action && item.action.length > 0 && (
+                    <Space className="notification-actions" onClick={(e) => e.stopPropagation()}>
+                      {item.action.map((action) => (
+                        <Button key={action.key} size="small" type="primary" ghost>
+                          {action.label}
+                        </Button>
+                      ))}
+                    </Space>
+                  )}
+                </div>
+                {!item.read && <div className="notification-dot" />}
+              </div>
+            ))}
+          </div>
+        )}
+      </Card>
+    </div>
+  );
+};
+
+export default Notifications;
