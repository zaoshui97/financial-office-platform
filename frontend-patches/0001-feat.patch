+
+.global-search-result-item.selected {
+  background: rgba(15, 43, 91, 0.08);
+}
+
+:root[data-theme="dark"] .global-search-result-item.selected {
+  background: rgba(74, 144, 217, 0.15);
+}
+
+.global-search-result-main {
+  flex: 1;
