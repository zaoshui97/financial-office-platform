+    { size: 150, top: '60%', left: '15%', delay: 2, duration: 25 },
+    { size: 180, top: '30%', right: '10%', delay: 1, duration: 22 },
+    { size: 120, bottom: '15%', right: '20%', delay: 3, duration: 18 },
+  ];
+
+  return (
+    <div style={{ position: 'absolute', inset: 0, overflow: 'hidden', pointerEvents: 'none' }}>
+      {shapes.map((shape, index) => (
+        <div
+          key={index}
