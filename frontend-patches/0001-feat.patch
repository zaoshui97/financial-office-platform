+/* ============================================================
+   会议房间样式 - 钉钉风格
+   ============================================================ */
+
+.meeting-room {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  width: 100vw;
+  height: 100vh;
+  display: flex;
+  flex-direction: column;
+  background: #0f0f23;
+  overflow: hidden;
+  z-index: 100;
+}
+
+.meeting-room.fullscreen {
+  z-index: 9999;
+}
+
+/* ============================================================
+   顶部栏
+   ============================================================ */
+
+.meeting-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 8px 16px;
+  background: #1a1a2e;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
+  height: 56px;
+}
+
+.meeting-header-left,
+.meeting-header-center,
+.meeting-header-right {
+  display: flex;
+  align-items: center;
+}
+
+.meeting-header-left {
+  flex: 1;
+}
+
+.meeting-header-center {
+  flex: 1;
+  justify-content: center;
+}
+
+.meeting-header-right {
+  flex: 1;
+  justify-content: flex-end;
+}
+
+.meeting-title {
