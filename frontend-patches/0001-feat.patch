+++ b/src/pages/Contacts/index.tsx
@@ -0,0 +1,274 @@
+import React, { useEffect, useMemo, useState } from 'react';
+import {
+  Card,
+  Input,
+  Avatar,
+  Typography,
+  Tag,
+  Empty,
+  Badge,
+  Space,
+  Button,
+  Tooltip,
+} from 'antd';
+import {
+  TeamOutlined,
+  SearchOutlined,
+  MessageOutlined,
+  CrownOutlined,
+  CheckCircleOutlined,
+  ReloadOutlined,
+} from '@ant-design/icons';
+import { useTranslation } from 'react-i18next';
+import { useContactsStore, useUserStore } from '@/store';
+import { ROLE_LABELS } from '@/types/permission';
+import type { ContactEmployee } from '@/types/contacts';
+import './index.css';
+
+const { Title, Text } = Typography;
+
+interface ContactsProps {
+  /** 点击联系人后跳转回调（交给 AppLayout 打开抽屉） */
+  onOpenChat?: (peer: ContactEmployee) => void;
+}
+
+const Contacts: React.FC<ContactsProps> = ({ onOpenChat }) => {
+  const { t, i18n } = useTranslation();
+  const { user } = useUserStore();
+  const employees = useContactsStore((s) => s.employees);
+  const bootstrap = useContactsStore((s) => s.bootstrap);
+  const getMessages = useContactsStore((s) => s.getMessages);
+  const getUnread = useContactsStore((s) => s.getUnread);
+
+  const [keyword, setKeyword] = useState('');
+
+  // 首次加载注入 mock
+  useEffect(() => {
+    bootstrap();
+  }, [bootstrap]);
+
+  const isZh = i18n.language === 'zh-CN';
+
+  // 过滤本人
+  const others = useMemo(
+    () => employees.filter((e) => e.username !== user?.username),
+    [employees, user]
+  );
+
+  // 按部门分组 + 过滤关键字
+  const grouped = useMemo(() => {
+    const kw = keyword.trim().toLowerCase();
+    const list = others.filter((e) => {
+      if (!kw) return true;
+      return (
+        e.name.toLowerCase().includes(kw) ||
+        e.department.toLowerCase().includes(kw) ||
+        e.position.toLowerCase().includes(kw) ||
+        (e.username || '').toLowerCase().includes(kw)
+      );
+    });
+
+    const map = new Map<string, ContactEmployee[]>();
+    list.forEach((e) => {
+      const arr = map.get(e.department) ?? [];
+      arr.push(e);
+      map.set(e.department, arr);
+    });
+
+    return Array.from(map.entries()).map(([department, list]) => ({
+      department,
+      list: list.sort((a, b) => {
+        // 在线排前面
+        if (a.online !== b.online) return a.online ? -1 : 1;
+        return a.name.localeCompare(b.name);
+      }),
+    }));
+  }, [others, keyword]);
+
+  // 最近会话：取所有写过消息的 peer，按最后一条消息时间倒序
+  const recentPeers = useMemo(() => {
+    if (!user) return [];
+    const allConversations: { peer: ContactEmployee; lastTime: string }[] = [];
+    others.forEach((e) => {
+      const msgs = getMessages(user.id, e.id);
+      if (msgs.length > 0) {
+        allConversations.push({
+          peer: e,
+          lastTime: msgs[msgs.length - 1].timestamp,
+        });
+      }
+    });
+    return allConversations
+      .sort((a, b) => b.lastTime.localeCompare(a.lastTime))
+      .slice(0, 5);
+  }, [user, others, getMessages]);
+
+  const handleClick = (employee: ContactEmployee) => {
+    if (onOpenChat) {
+      onOpenChat(employee);
+      return;
+    }
+    // 回退方案：派发事件
+    document.dispatchEvent(
+      new CustomEvent('open-chat', { detail: employee })
+    );
+  };
+
+  return (
+    <div className="contacts-page">
+      <div className="contacts-header">
+        <Space>
+          <TeamOutlined style={{ fontSize: 24, color: 'var(--color-primary)' }} />
+          <Title level={4} style={{ margin: 0 }}>
+            {t('nav.contacts')}
+          </Title>
+          <Tag>{employees.length} {t('auto.10')}</Tag>
+        </Space>
+        <Input
+          placeholder={t('auto.9')}
+          prefix={<SearchOutlined />}
+          value={keyword}
+          onChange={(e) => setKeyword(e.target.value)}
+          allowClear
+          style={{ width: 320 }}
+        />
+      </div>
+
+      <div className="contacts-body">
+        {/* 最近联系 */}
+        {recentPeers.length > 0 && (
+          <Card
+            className="contacts-recent-card"
+            title={
+              <Space>
+                <MessageOutlined />
+                <Text strong>{t('auto.8')}</Text>
+              </Space>
+            }
+            size="small"
+          >
+            <div className="recent-list">
+              {recentPeers.map(({ peer }) => {
+                const unread = getUnread(user?.id ?? '', peer.id);
+                return (
+                  <div
+                    key={peer.id}
+                    className="recent-item"
+                    onClick={() => handleClick(peer)}
+                  >
+                    <Badge count={unread} size="small">
+                      <Avatar style={{ backgroundColor: peer.avatar || '#1890ff' }}>
+                        {peer.name.charAt(0)}
+                      </Avatar>
+                    </Badge>
+                    <Text className="recent-name" ellipsis>
+                      {peer.name}
+                    </Text>
+                  </div>
+                );
+              })}
+            </div>
+          </Card>
+        )}
+
+        {/* 按部门分组 */}
+        <Card
+          className="contacts-list-card"
+          title={
+            <Space>
+              <TeamOutlined />
+              <Text strong>{t('auto.7')}</Text>
+            </Space>
+          }
+          size="small"
+        >
+          {grouped.length === 0 ? (
+            <Empty
+              image={Empty.PRESENTED_IMAGE_SIMPLE}
+              description={t('auto.6')}
+            />
+          ) : (
+            grouped.map(({ department, list }) => (
+              <div key={department} className="department-group">
+                <div className="department-header">
+                  <Text type="secondary" className="department-name">
+                    {department}
+                  </Text>
+                  <Tag>{list.length}</Tag>
+                </div>
+                <div className="employee-grid">
+                  {list.map((e) => {
+                    const roleLabel = ROLE_LABELS[e.role];
+                    return (
+                      <div
+                        key={e.id}
+                        className="employee-card"
+                        onClick={() => handleClick(e)}
+                      >
+                        <Badge
+                          dot
+                          color={e.online ? '#52c41a' : '#bfbfbf'}
+                          offset={[-4, 36]}
+                        >
+                          <Avatar
+                            size={48}
+                            style={{ backgroundColor: e.avatar || '#1890ff' }}
+                          >
+                            {e.name.charAt(0)}
+                          </Avatar>
+                        </Badge>
+                        <div className="employee-info">
+                          <Space size={4} className="employee-name-line">
+                            <Text strong ellipsis style={{ maxWidth: 120 }}>
+                              {e.name}
+                            </Text>
+                            {e.role === 'SUPER_ADMIN' && (
+                              <Tooltip title={roleLabel}>
+                                <CrownOutlined style={{ color: '#faad14' }} />
+                              </Tooltip>
+                            )}
+                          </Space>
+                          <Text type="secondary" className="employee-position" ellipsis>
+                            {e.position}
+                          </Text>
+                          <Space size={4}>
+                            {e.online ? (
+                              <Tag color="success" style={{ margin: 0, fontSize: 11 }}>
+                                <CheckCircleOutlined /> {t('auto.5')}
+                              </Tag>
+                            ) : (
+                              <Tag style={{ margin: 0, fontSize: 11 }}>
+                                {t('auto.4')}
+                              </Tag>
+                            )}
+                          </Space>
+                        </div>
+                        <Button
+                          type="primary"
+                          ghost
+                          size="small"
+                          icon={<MessageOutlined />}
+                          onClick={(ev) => {
+                            ev.stopPropagation();
+                            handleClick(e);
+                          }}
+                        >
+                          {t('auto.3')}
+                        </Button>
+                      </div>
+                    );
+                  })}
+                </div>
+              </div>
+            ))
+          )}
+        </Card>
+      </div>
+    </div>
+  );
+};
+
+// 暴露给父组件的事件帮助函数
+export const openChatEvent = 'open-chat';
+
+export default Contacts;
