+  color: #58a6ff;
+}
+
+.global-search-timestamp {
+  font-size: 11px;
+  color: var(--color-text-hint);
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+/* 底部快捷键提示 */
+.global-search-footer {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 20px;
+  padding: 10px 20px;
+  border-top: 1px solid var(--color-border);
