+    { source: 'c5', target: 'r1', relation: '相关' },
+
+    // 跨概念关联
+    { source: 'c2', target: 'c3', relation: '影响' },
+    { source: 'c1', target: 'c4', relation: '属于' },
+
+    // 人员关联
+    { source: 'p1', target: 'p2', relation: '协作' },
