diff --git a/src/pages/Dashboard/components/AIWorkbench/index.tsx b/src/pages/Dashboard/components/AIWorkbench/index.tsx
new file mode 100644
index 0000000..f46acbe
--- /dev/null
+++ b/src/pages/Dashboard/components/AIWorkbench/index.tsx
@@ -0,0 +1,221 @@
+import React, { useState, useEffect } from 'react';
+import { Card, Typography, Space, Tag, Spin, Button, Tooltip, Empty } from 'antd';
+import {
+  FireOutlined,
+  BulbOutlined,
+  ClockCircleOutlined,
+  CheckCircleOutlined,
+  ExclamationCircleOutlined,
+  CalendarOutlined,
+  RobotOutlined,
+  ArrowRightOutlined,
+  SyncOutlined,
+} from '@ant-design/icons';
+import { useNavigate } from 'react-router-dom';
+import { useTranslation } from 'react-i18next';
+import { generateAIWorkbenchSummary, hasApiKey } from '@/api/ai';
+import type { ActionItem, Meeting } from '@/types/api';
+import './index.css';
+
+const { Title, Text, Paragraph } = Typography;
+
+interface AIWorkbenchProps {
+  actionItems: ActionItem[];
+  meetings: Meeting[];
+  knowledgeUpdates?: number;
+}
+
+interface AISummary {
+  priorityItems: string[];
+  suggestions: string[];
+  timeEstimate: string;
+}
+
+const AIWorkbench: React.FC<AIWorkbenchProps> = ({
+  actionItems,
+  meetings,
+  knowledgeUpdates = 5,
+}) => {
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const [loading, setLoading] = useState(false);
+  const [summary, setSummary] = useState<AISummary | null>(null);
+  const [hasKey, setHasKey] = useState(false);
+  const [initialized, setInitialized] = useState(false);
+
+  // 计算紧急待办
+  const urgentItems = actionItems.filter(
+    (item) => item.status === 'todo' || item.status === 'in_progress'
+  );
+
+  // 计算即将开始的会议
+  const upcomingMeetings = meetings.filter((m) => m.status === 'pending').slice(0, 2);
+
+  // 初始加载 AI 摘要（仅加载一次）
+  useEffect(() => {
+    if (initialized) return;
+
+    const loadSummary = async () => {
+      setLoading(true);
+      try {
+        const hasKeyResult = hasApiKey();
+        setHasKey(hasKeyResult);
+
+        const result = await generateAIWorkbenchSummary({
+          actionItems: urgentItems,
+          meetings: upcomingMeetings,
+          knowledgeUpdates,
+          userName: '用户',
+        });
+        setSummary(result);
+      } catch (error) {
+        console.error('Failed to load AI summary:', error);
+      } finally {
+        setLoading(false);
+        setInitialized(true);
+      }
+    };
+
+    loadSummary();
+  }, []);
+
+  const getStatusIcon = (status: ActionItem['status']) => {
+    switch (status) {
+      case 'todo':
+        return <ExclamationCircleOutlined style={{ color: '#E69948' }} />;
+      case 'in_progress':
+        return <SyncOutlined spin style={{ color: '#3B82F6' }} />;
+      case 'done':
+        return <CheckCircleOutlined style={{ color: '#22A775' }} />;
+    }
+  };
+
+  return (
+    <Card className="ai-workbench" title={
+      <Space>
+        <RobotOutlined style={{ color: '#0F2B5B' }} />
+        <span>AI 工作台</span>
+      </Space>
+    }
+    extra={
+      <Tooltip title={hasKey ? 'AI 已连接' : '请在设置中配置 API Key'}>
+        <Tag color={hasKey ? 'success' : 'warning'}>
+          {hasKey ? 'DeepSeek 在线' : '演示模式'}
+        </Tag>
+      </Tooltip>
+    }
+    >
+      <div className="ai-workbench-content">
+        {/* 今日优先事项 */}
+        <div className="ai-section">
+          <div className="ai-section-header">
+            <FireOutlined style={{ color: '#D64045' }} />
+            <Text strong>{t('aiWorkbench.todayPriority')}</Text>
+            <Tag color="red">{urgentItems.length} {t('aiWorkbench.items')}</Tag>
+          </div>
+          {loading ? (
+            <div className="ai-loading">
+              <Spin size="small" />
+              <Text type="secondary">{t('aiWorkbench.analyzing')}</Text>
+            </div>
+          ) : urgentItems.length === 0 ? (
+            <Empty description={t('common.noData')} image={Empty.PRESENTED_IMAGE_SIMPLE} />
+          ) : (
+            <div>
+              {urgentItems.slice(0, 3).map((item) => (
+                <div key={item.id} className="ai-priority-item">
+                  {getStatusIcon(item.status)}
+                  <Text className="ai-priority-text">{item.description}</Text>
+                  <Tag color={item.status === 'in_progress' ? 'blue' : 'warning'}>
+                    {item.dueDate}
+                  </Tag>
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+
+        {/* 即将开始的会议 */}
+        {upcomingMeetings.length > 0 && (
+          <div className="ai-section">
+            <div className="ai-section-header">
+              <CalendarOutlined style={{ color: '#3B82F6' }} />
+              <Text strong>{t('aiWorkbench.upcomingMeetings')}</Text>
+              <Tag color="blue">{upcomingMeetings.length}</Tag>
+            </div>
+            <div>
+              {upcomingMeetings.map((meeting) => (
+                <div key={meeting.id} className="ai-meeting-item">
+                  <CalendarOutlined />
+                  <Text>{meeting.title}</Text>
+                  <Text type="secondary" style={{ fontSize: 12 }}>{meeting.startTime}</Text>
+                </div>
+              ))}
+            </div>
+          </div>
+        )}
+
+        {/* AI 建议 */}
+        <div className="ai-section ai-suggestions">
+          <div className="ai-section-header">
+            <BulbOutlined style={{ color: '#C9A459' }} />
+            <Text strong>{t('aiWorkbench.aiSuggestions')}</Text>
+          </div>
+          {loading ? (
+            <div className="ai-loading">
+              <Spin size="small" />
+              <Text type="secondary">{t('aiWorkbench.generating')}</Text>
+            </div>
+          ) : summary ? (
+            <>
+              <ul className="ai-suggestion-list">
+                {summary.suggestions.map((suggestion, index) => (
+                  <li key={index} className="ai-suggestion-item">
+                    <BulbOutlined style={{ color: '#C9A459', fontSize: 12 }} />
+                    <Text>{suggestion}</Text>
+                  </li>
+                ))}
+              </ul>
+              <div className="ai-time-estimate">
+                <ClockCircleOutlined />
+                <Text type="secondary">
+                  {t('aiWorkbench.estimateSave')} {summary.timeEstimate}
+                </Text>
+              </div>
+            </>
+          ) : (
+            <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={t('aiWorkbench.noSuggestions')} />
+          )}
+        </div>
+
+        {/* 快捷操作 */}
+        <div className="ai-quick-actions">
+          <Button
+            size="small"
+            icon={<RobotOutlined />}
+            onClick={() => navigate('/qa')}
+          >
+            {t('aiWorkbench.askAI')}
+          </Button>
+          <Button
+            size="small"
+            icon={<CalendarOutlined />}
+            onClick={() => navigate('/meeting')}
+          >
+            {t('aiWorkbench.scheduleMeeting')}
+          </Button>
+          <Button
+            size="small"
+            type="link"
+            icon={<ArrowRightOutlined />}
+            onClick={() => navigate('/agent')}
+          >
+            {t('aiWorkbench.moreFeatures')}
+          </Button>
+        </div>
+      </div>
+    </Card>
+  );
+};
+
+export default AIWorkbench;
