@@ -0,0 +1,108 @@
+import Mock from 'mockjs';
+import { mockUser, mockStatistics, mockDocuments, mockMeetings, mockKnowledgeList, mockInsights, mockTasks } from './data';
+
+// 判断是否使用 Mock 数据
+const useMock = import.meta.env.VITE_USE_MOCK === 'true';
+
+// 延迟函数
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+// Mock API 配置
+if (useMock) {
+  console.log('[Mock] 已启用 Mock 数据模式');
+
+  // 用户信息
+  Mock.mock(/\/api\/user\/info/, 'get', async () => {
+    await delay(300);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockUser,
+    };
+  });
+
+  // 统计数据
+  Mock.mock(/\/api\/statistics/, 'get', async () => {
+    await delay(200);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockStatistics,
+    };
+  });
+
+  // 文档列表
+  Mock.mock(/\/api\/documents/, 'get', async () => {
+    await delay(400);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockDocuments,
+    };
+  });
+
+  // 会议列表
+  Mock.mock(/\/api\/meetings/, 'get', async () => {
+    await delay(400);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockMeetings,
+    };
+  });
+
+  // 知识库列表
+  Mock.mock(/\/api\/knowledge/, 'get', async () => {
+    await delay(400);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockKnowledgeList,
+    };
+  });
+
+  // 行业洞察列表
+  Mock.mock(/\/api\/insights/, 'get', async () => {
+    await delay(400);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockInsights,
+    };
+  });
+
+  // 待办事项
+  Mock.mock(/\/api\/tasks/, 'get', async () => {
+    await delay(300);
+    return {
+      code: 200,
+      message: 'success',
+      data: mockTasks,
+    };
+  });
+
+  // AI 对话（模拟）
+  Mock.mock(/\/api\/chat/, 'post', async (options: any) => {
+    await delay(1500);
+    const body = JSON.parse(options.body);
+    const message = body.message || '';
+
+    let response = '感谢您的提问。我会尽力帮助您解决问题。';
+    if (message.includes('合同')) {
+      response = '好的，我可以帮您分析合同。请上传您的合同文档，我会从以下几个方面进行分析：\n\n1. 合同主体信息\n2. 关键条款识别\n3. 潜在风险点\n4. 法规合规性';
+    } else if (message.includes('会议') || message.includes('纪要')) {
+      response = '我可以帮您生成会议纪要。请提供以下信息：\n\n1. 会议主题和参与人员\n2. 会议的主要内容\n3. 会议时间';
+    }
+
+    return {
+      code: 200,
+      message: 'success',
+      data: {
+        reply: response,
+        sessionId: Date.now(),
+      },
+    };
+  });
+}
+
+export { Mock };
