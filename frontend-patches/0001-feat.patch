+
+2. **Risk Control**
+   - Risk identification mechanisms
+   - Tiered risk management
+
+3. **Monitoring**
+   - Regular compliance audits
+   - Issue tracking systems
+
+\`\`\`python
+# Compliance check example
+def check_compliance(system_config):
+    required_fields = ['security_level', 'data_encryption']
+    return all(field in system_config for field in required_fields)
+\`\`\`
+
+For more details, please refer to relevant regulations.`,
+        references: [
+          { id: 'doc-001', title: 'Securities IT Management Guidelines', source: 'Compliance' },
+          { id: 'doc-002', title: 'Financial Compliance Standards', source: 'Compliance' },
+        ],
+      };
+    }
+
+    if (lowerInput.includes('meeting') || lowerInput.includes('summary')) {
+      return {
+        content: `Here's how to generate meeting minutes:
+
+## Steps
+
+### 1. Setup
+- Configure audio input
+- Set up transcription
+
+### 2. Processing
+- AI transcription
+- Key point extraction
+
+### 3. Output
+- Action items list
+- Decision summary
+
+\`\`\`javascript
+// Generate summary API
+const summary = await api.meeting.generateSummary({
+  transcript: meetingAudio,
+  options: {
+    includeActionItems: true,
+    includeDecisions: true
+  }
+});
+\`\`\`
+
+The system will automatically extract **action items** and **key decisions** for you.`,
+        references: [],
+      };
+    }
+
+    return { content: 'I understand your question. Let me help you find the right information. Could you provide more details?', references: [] };
+  };
+
+  const getConversationMenu = (conv: Conversation) => ({
