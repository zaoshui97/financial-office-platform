@@ -0,0 +1,288 @@
+import React, { useState } from 'react';
+import { Card, Row, Col, Typography, Tag, Space, Button, Table, Badge, Progress, Tooltip, Modal, Steps, Divider, message } from 'antd';
+import {
+  RobotOutlined,
+  ThunderboltOutlined,
+  CheckCircleOutlined,
+  ClockCircleOutlined,
+  ExclamationCircleOutlined,
+  PlayCircleOutlined,
+  PauseCircleOutlined,
+  DeleteOutlined,
+  EyeOutlined,
+  InfoCircleOutlined,
+} from '@ant-design/icons';
+import { useTranslation } from 'react-i18next';
+import type { ColumnsType } from 'antd/es/table';
+
+const { Title, Text, Paragraph } = Typography;
+
+interface AgentTask {
+  id: string;
+  name: string;
+  type: string;
+  status: 'idle' | 'running' | 'completed' | 'failed';
+  progress: number;
+  createdAt: string;
+  duration?: string;
+  agents: string[];
+}
+
+interface AgentInfo {
+  id: string;
+  name: string;
+  icon: React.ReactNode;
+  status: 'online' | 'busy' | 'offline';
+  taskCount: number;
+  description: string;
+}
+
+const AgentCenter: React.FC = () => {
+  const { t } = useTranslation();
+  const [selectedTask, setSelectedTask] = useState<AgentTask | null>(null);
+  const [detailVisible, setDetailVisible] = useState(false);
+
+  const agents: AgentInfo[] = [
+    { id: '1', name: 'Meeting Assistant', icon: <RobotOutlined />, status: 'online', taskCount: 5, description: 'Automate end-to-end meeting workflows: scheduling, minutes generation, and action item sync.' },
+    { id: '2', name: 'Document Parser', icon: <RobotOutlined />, status: 'busy', taskCount: 3, description: 'Intelligently parse contracts, reports, and documents to extract key information.' },
+    { id: '3', name: 'Regulation Search', icon: <RobotOutlined />, status: 'online', taskCount: 8, description: 'Track financial regulatory updates in real-time and interpret new requirements.' },
+    { id: '4', name: 'Knowledge Q&A', icon: <RobotOutlined />, status: 'online', taskCount: 12, description: 'Answer business questions intelligently based on the enterprise knowledge base.' },
+    { id: '5', name: 'Data Analytics', icon: <RobotOutlined />, status: 'offline', taskCount: 0, description: 'Auto-generate data analysis reports with multi-dimensional statistics.' },
+  ];
+
+  const tasks: AgentTask[] = [
+    { id: 't1', name: 'Quarterly Meeting Minutes Generation', type: 'Meeting Assistant', status: 'running', progress: 65, createdAt: '2026-07-24 14:30', agents: ['Meeting Assistant', 'Knowledge Q&A'], duration: '2 min 30 sec' },
+    { id: 't2', name: 'Compliance Document Parsing', type: 'Document Parser', status: 'completed', progress: 100, createdAt: '2026-07-24 14:00', agents: ['Document Parser'], duration: '5 min 12 sec' },
+    { id: 't3', name: 'Central Bank New Regulation Interpretation', type: 'Regulation Search', status: 'completed', progress: 100, createdAt: '2026-07-24 13:45', agents: ['Regulation Search', 'Knowledge Q&A'], duration: '1 min 15 sec' },
+    { id: 't4', name: 'Q2 Sales Report Generation', type: 'Data Analytics', status: 'failed', progress: 40, createdAt: '2026-07-24 13:30', agents: ['Data Analytics'], duration: '3 min 10 sec' },
+    { id: 't5', name: 'Meeting Booking - Product Review', type: 'Meeting Assistant', status: 'idle', progress: 0, createdAt: '2026-07-24 15:00', agents: ['Meeting Assistant'] },
+  ];
+
+  const getStatusTag = (status: AgentTask['status']) => {
+    const config: Record<string, { color: string; text: string; icon: React.ReactNode }> = {
+      idle: { color: 'default', text: 'Idle', icon: <ClockCircleOutlined /> },
+      running: { color: 'processing', text: 'Running', icon: <PlayCircleOutlined /> },
+      completed: { color: 'success', text: 'Completed', icon: <CheckCircleOutlined /> },
+      failed: { color: 'error', text: 'Failed', icon: <ExclamationCircleOutlined /> },
+    };
+    return <Tag color={config[status].color} icon={config[status].icon}>{config[status].text}</Tag>;
+  };
+
+  const getAgentStatus = (status: AgentInfo['status']) => {
+    const config: Record<string, { color: string; text: string }> = {
+      online: { color: 'success', text: 'Online' },
+      busy: { color: 'warning', text: 'Busy' },
+      offline: { color: 'default', text: 'Offline' },
+    };
+    return <Badge status={config[status].color as any} text={config[status].text} />;
+  };
+
+  const columns: ColumnsType<AgentTask> = [
+    { title: 'Task Name', dataIndex: 'name', key: 'name', render: (text) => <Text strong>{text}</Text> },
+    { title: 'Type', dataIndex: 'type', key: 'type', render: (text) => <Tag>{text}</Tag> },
+    { title: 'Status', dataIndex: 'status', key: 'status', render: (status) => getStatusTag(status) },
+    { title: 'Progress', dataIndex: 'progress', key: 'progress', render: (p, record) => record.status === 'running' ? <Progress percent={p} size="small" /> : <Progress percent={p} size="small" status={record.status === 'failed' ? 'exception' : undefined} /> },
+    { title: 'Duration', dataIndex: 'duration', key: 'duration', render: (d) => d || '-' },
+    { title: 'Agents', dataIndex: 'agents', key: 'agents', render: (agents) => <Space>{agents.map(a => <Tag key={a} color="blue">{a}</Tag>)}</Space> },
+    {
+      title: 'Action',
+      key: 'action',
+      render: (_, record) => (
+        <Space>
+          <Tooltip title="View Details">
+            <Button type="text" size="small" icon={<EyeOutlined />} onClick={() => { setSelectedTask(record); setDetailVisible(true); }} />
+          </Tooltip>
+          {record.status === 'running' && (
+            <Button
+              type="text"
+              size="small"
+              icon={<PauseCircleOutlined />}
+              danger
+              onClick={() => {
+                message.warning('Task paused');
+              }}
+            />
+          )}
+          {record.status === 'failed' && (
+            <Button
+              type="text"
+              size="small"
+              icon={<PlayCircleOutlined />}
+              onClick={() => {
+                message.success('Retrying...');
+              }}
+            />
+          )}
+          <Button
+            type="text"
+            size="small"
+            icon={<DeleteOutlined />}
+            danger
+            onClick={() => {
+              Modal.confirm({
+                title: 'Confirm Delete',
+                content: `Are you sure you want to delete task "${record.name}"?`,
+                okText: 'Confirm',
+                cancelText: 'Cancel',
+                okButtonProps: { danger: true },
+                onOk: () => {
+                  message.success('Task deleted');
+                },
+              });
+            }}
+          />
+        </Space>
+      ),
+    },
+  ];
+
+  return (
+    <div style={{ padding: 20, background: '#F7F9FC', minHeight: '100%' }}>
+      <div style={{ marginBottom: 20 }}>
+        <Title level={4} style={{ margin: 0, color: '#1D2129' }}>
+          <RobotOutlined style={{ marginRight: 8 }} />
+          Multi-Agent Orchestration Center
+        </Title>
+        <Text type="secondary">Visualize and monitor AI Agent collaboration workflows - multiple agents working together to complete tasks</Text>
+      </div>
+
+      <Card title="Active Agents" style={{ marginBottom: 20 }}>
+        <Row gutter={16}>
+          {agents.map((agent) => (
+            <Col span={6} key={agent.id}>
+              <Card
+                hoverable
+                style={{ border: '1px solid #E8EDF4' }}
+                styles={{ body: { padding: 16 } }}
+              >
+                <div style={{ display: 'flex', alignItems: 'center', marginBottom: 12 }}>
+                  <div
+                    style={{
+                      width: 40,
+                      height: 40,
+                      borderRadius: 6,
+                      background: 'linear-gradient(135deg, #0F2B5B 0%, #1a4a8a 100%)',
+                      display: 'flex',
+                      alignItems: 'center',
+                      justifyContent: 'center',
+                      color: '#fff',
+                      fontSize: 18,
+                      marginRight: 12,
+                    }}
+                  >
+                    {agent.icon}
+                  </div>
+                  <div>
+                    <Text strong>{agent.name}</Text>
+                    <div>{getAgentStatus(agent.status)}</div>
+                  </div>
+                </div>
+                <Paragraph type="secondary" ellipsis={{ rows: 2 }} style={{ fontSize: 12, marginBottom: 8 }}>
+                  {agent.description}
+                </Paragraph>
+                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
+                  <Text type="secondary" style={{ fontSize: 12 }}>
+                    Current tasks: {agent.taskCount}
+                  </Text>
+                  <Button
+                    type="link"
+                    size="small"
+                    onClick={() => {
+                      Modal.info({
+                        title: 'View Log',
+                        width: 600,
+                        content: (
+                          <div style={{ maxHeight: 400, overflow: 'auto' }}>
+                            <pre style={{ background: '#f5f5f5', padding: 12, borderRadius: 4, fontSize: 12 }}>
+{`[14:30:00] Task created, starting to parse requirements...
+[14:30:05] Task parsing completed, identified need for 2 Agents to collaborate
+[14:30:06] Dispatched Meeting Assistant Agent to execute task
+[14:31:30] Meeting Assistant Agent returned result
+[14:31:31] Dispatched Knowledge Q&A Agent for supplementation
+[14:32:00] Task executing... (65%)
+[14:32:30] Knowledge Q&A Agent returned result
+[14:32:31] Merging output from both Agents
+[14:32:45] Final report generated`}
+                            </pre>
+                          </div>
+                        ),
+                        okText: 'Close',
+                      });
+                    }}
+                  >
+                    View Log
+                  </Button>
+                </div>
+              </Card>
+            </Col>
+          ))}
+        </Row>
+      </Card>
+
+      <Card title="Task Execution List">
+        <Table columns={columns} dataSource={tasks} rowKey="id" pagination={false} />
+      </Card>
+
+      <Modal
+        title="Task Details"
+        open={detailVisible}
+        onCancel={() => setDetailVisible(false)}
+        footer={[
+          <Button key="close" onClick={() => setDetailVisible(false)}>Close</Button>,
+          <Button
+            key="rerun"
+            type="primary"
+            icon={<PlayCircleOutlined />}
+            onClick={() => {
+              message.success('Task re-execution started...');
+              setDetailVisible(false);
+            }}
+          >
+            Re-run
+          </Button>,
+        ]}
+        width={700}
+      >
+        {selectedTask && (
+          <div>
+            <Space orientation="vertical" style={{ width: '100%' }} size="large">
+              <div>
+                <Text type="secondary">Task Name: </Text>
+                <Text strong>{selectedTask.name}</Text>
+              </div>
+              <div>
+                <Text type="secondary">Execution Steps: </Text>
+                <Steps
+                  current={selectedTask.status === 'completed' ? 3 : selectedTask.status === 'failed' ? 2 : Math.floor(selectedTask.progress / 30)}
+                  items={[
+                    { title: 'Task Parsing', description: 'Analyzing task requirements' },
+                    { title: 'Agent Dispatch', description: 'Assigning execution agents' },
+                    { title: 'Execution', description: `${selectedTask.progress}%` },
+                    { title: 'Result Aggregation', description: 'Generating execution report' },
+                  ]}
+                />
+              </div>
+              <div>
+                <Text type="secondary">Agents: </Text>
+                <Space>{selectedTask.agents.map(a => <Tag key={a} color="blue">{a}</Tag>)}</Space>
+              </div>
+              <div>
+                <Text type="secondary">Execution Log: </Text>
+                <div style={{ background: '#F7F9FC', padding: 12, borderRadius: 6, fontSize: 12, fontFamily: 'monospace' }}>
+                  <div>[14:30:00] Task created, starting to parse requirements...</div>
+                  <div>[14:30:05] Task parsing completed, identified need for 2 Agents</div>
+                  <div>[14:30:06] Dispatched Meeting Assistant Agent to execute task</div>
+                  <div>[14:31:30] Meeting Assistant Agent returned result</div>
+                  <div>[14:31:31] Dispatched Knowledge Q&A Agent for supplementation</div>
+                  <div>[14:32:00] Task executing... ({selectedTask.progress}%)</div>
+                </div>
+              </div>
+            </Space>
+          </div>
+        )}
+      </Modal>
+    </div>
+  );
+};
+
+export default AgentCenter;
