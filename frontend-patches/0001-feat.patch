+/**
+ * MeetingRehearsal — 会前预演
+ *
+ * 在会议开始前，4 Agent 模拟 4 位参会人预演一遍议题。
+ * 用户可看到会议可能讨论到的关键问题、决策点、待办、风险信号，
+ * 并能直接进入会议。
+ */
+
+import React, { useEffect, useState } from 'react';
+import { useParams, useNavigate } from 'react-router-dom';
+import {
+  Card,
+  Row,
+  Col,
+  Typography,
+  Button,
+  Space,
+  Tag,
+  Steps,
+  Alert,
+  Empty,
+  Progress,
+  message,
+} from 'antd';
+import {
+  PlayCircleOutlined,
+  CheckCircleOutlined,
+  ClockCircleOutlined,
+  ArrowRightOutlined,
+  BulbOutlined,
+  RobotOutlined,
+  ExperimentOutlined,
+} from '@ant-design/icons';
+import { useTranslation } from 'react-i18next';
+import i18n from '@/i18n';
+import { AgentCard } from '@/components/Meeting/AgentCard';
+import { Blackboard } from '@/components/Meeting/Blackboard';
+import {
+  useAllAgentRunStates,
+  useBlackboard,
+} from '@/services/useMultiAgent';
+import { runRehearsal, resetMeeting } from '@/services/multiAgentOrchestrator';
+import '@/components/Meeting/AgentPanel.css';
+
+const { Title, Text, Paragraph } = Typography;
+
+const MeetingRehearsal: React.FC = () => {
+  const { id } = useParams<{ id: string }>();
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const [isZh] = useState(i18n.language === 'zh-CN');
+  const [currentStep, setCurrentStep] = useState(0);
+
+  const agents = useAllAgentRunStates();
+  const bb = useBlackboard();
+
+  useEffect(() => {
+    if (id) {
+      resetMeeting(id);
+    }
+  }, [id]);
+
+  const steps = isZh
+    ? [
+        { title: '预演前', desc: '加载议程 + 历史偏好' },
+        { title: '预演中', desc: '4 Agent 模拟参会' },
+        { title: '预演完成', desc: '提炼关键风险 + 建议' },
+        { title: '进入会议', desc: '一键开始正式会议' },
+      ]
+    : [
+        { title: 'Before', desc: 'Load agenda + preferences' },
+        { title: 'Rehearsing', desc: '4 agents simulate' },
+        { title: 'Done', desc: 'Extract risks + suggestions' },
+        { title: 'Enter', desc: 'Start the real meeting' },
+      ];
+
+  const handleStartRehearsal = async () => {
+    setCurrentStep(1);
+    await runRehearsal();
+    setCurrentStep(2);
+  };
+
+  const handleEnterMeeting = () => {
+    setCurrentStep(3);
+    message.success(isZh ? '进入正式会议' : 'Entering meeting');
+    setTimeout(() => {
+      navigate(`/meeting-room/${id}`);
+    }, 600);
+  };
+
+  // 计算预演"健康度"
+  const rehearsalScore =
+    bb.decisions.length * 5 +
+    bb.actions.length * 3 +
+    bb.risks.length * 8 +
+    bb.topics.length * 4;
+  const readiness = Math.min(100, 40 + rehearsalScore);
+
+  return (
+    <div className="rehearsal-page">
+      <div style={{ maxWidth: 1200, margin: '0 auto' }}>
+        {/* Header */}
+        <div style={{ marginBottom: 24, textAlign: 'center' }}>
+          <Title level={2} style={{ marginBottom: 8 }}>
+            <ExperimentOutlined style={{ marginRight: 12, color: '#722ed1' }} />
+            {isZh ? '会前智能预演' : 'Pre-Meeting AI Rehearsal'}
+          </Title>
+          <Paragraph type="secondary" style={{ fontSize: 14 }}>
+            {isZh
+              ? '4 个 AI Agent 将扮演所有参会人，预演本次会议的关键讨论、决策点与风险信号'
+              : '4 AI Agents will simulate all participants to rehearse key discussions, decisions, and risk signals'}
+          </Paragraph>
+        </div>
+
+        {/* Steps */}
+        <Card style={{ marginBottom: 16 }}>
+          <Steps current={currentStep} items={steps} />
+        </Card>
+
+        {currentStep === 0 && (
+          <Card style={{ textAlign: 'center', padding: '40px 20px' }}>
+            <RobotOutlined style={{ fontSize: 64, color: '#722ed1', marginBottom: 16 }} />
+            <Title level={4}>
+              {isZh ? '准备好开始预演了吗？' : 'Ready to start the rehearsal?'}
+            </Title>
+            <Paragraph type="secondary">
+              {isZh
+                ? '预演将基于您最近的会议偏好 + 本次会议议程，模拟 4 位参会人的关键讨论'
+                : 'The rehearsal will simulate 4 participants based on your recent preferences + this meeting agenda'}
+            </Paragraph>
+            <Button
+              type="primary"
+              size="large"
+              icon={<PlayCircleOutlined />}
+              onClick={handleStartRehearsal}
+              style={{
+                background: 'linear-gradient(135deg, #0F2B5B, #722ed1)',
+                border: 'none',
+                marginTop: 16,
+              }}
+            >
+              {isZh ? '开始预演' : 'Start Rehearsal'}
+            </Button>
+          </Card>
+        )}
+
+        {(currentStep === 1 || currentStep === 2) && (
+          <Row gutter={16}>
+            <Col span={14}>
+              <Card title={<><TeamOutlined /> {isZh ? '4 Agent 实时状态' : '4 Agents Live Status'}</>}>
+                <Space direction="vertical" size={10} style={{ width: '100%' }}>
+                  <AgentCard role="moderator" state={agents.moderator} isZh={isZh} />
+                  <AgentCard role="notetaker" state={agents.notetaker} isZh={isZh} />
+                  <AgentCard role="decision" state={agents.decision} isZh={isZh} />
+                  <AgentCard role="action" state={agents.action} isZh={isZh} />
+                </Space>
+              </Card>
+            </Col>
+
+            <Col span={10}>
+              <Space direction="vertical" size={12} style={{ width: '100%' }}>
+                <Card>
+                  <div style={{ textAlign: 'center' }}>
+                    <Text type="secondary">{isZh ? '会议就绪度' : 'Meeting Readiness'}</Text>
+                    <Progress
+                      type="circle"
+                      percent={readiness}
+                      strokeColor={{
+                        '0%': '#52c41a',
+                        '100%': '#722ed1',
+                      }}
+                      style={{ marginTop: 8 }}
+                    />
+                    <div style={{ marginTop: 12 }}>
+                      {readiness >= 80 ? (
+                        <Tag color="success" icon={<CheckCircleOutlined />}>
+                          {isZh ? '就绪度高，可直接开始' : 'High readiness, ready to start'}
+                        </Tag>
+                      ) : readiness >= 50 ? (
+                        <Tag color="warning">
+                          {isZh ? '建议补充议程细节' : 'Recommend more agenda details'}
+                        </Tag>
+                      ) : (
+                        <Tag color="default">
+                          {isZh ? '预演中…' : 'Rehearsing…'}
+                        </Tag>
+                      )}
+                    </div>
+                  </div>
+                </Card>
+
+                <Card title={<><BulbOutlined /> {isZh ? '预演黑板' : 'Rehearsal Blackboard'}</>}>
+                  <Blackboard isZh={isZh} />
+                </Card>
+              </Space>
+            </Col>
+          </Row>
+        )}
+
+        {currentStep === 2 && (
+          <div style={{ textAlign: 'center', marginTop: 24 }}>
+            <Alert
+              type="info"
+              showIcon
+              style={{ maxWidth: 720, margin: '0 auto 16px' }}
+              message={isZh ? '预演已识别出本次会议的关键讨论点' : 'Rehearsal has identified key discussion points'}
+              description={
+                isZh
+                  ? `${bb.decisions.length} 个决策点、${bb.actions.length} 个待办事项、${bb.risks.length} 个风险信号。建议在正式会议开始前与相关干系人预先沟通。`
+                  : `${bb.decisions.length} decisions, ${bb.actions.length} action items, ${bb.risks.length} risks. Recommend pre-alignment with stakeholders.`
+              }
+            />
+            <Button
+              type="primary"
+              size="large"
+              icon={<ArrowRightOutlined />}
+              onClick={handleEnterMeeting}
+              style={{
+                background: 'linear-gradient(135deg, #52c41a, #1890ff)',
+                border: 'none',
+              }}
+            >
+              {isZh ? '进入正式会议' : 'Enter Real Meeting'}
+            </Button>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default MeetingRehearsal;
