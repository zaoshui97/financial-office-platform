@@ -0,0 +1,239 @@
+/**
+ * AgentPanel — 多 Agent 协作面板
+ *
+ * 布局：
+ *   ┌──────────────────────────────┐
+ *   │  🎯 Moderator  [Running]     │
+ *   │  📝 Notetaker   [Done]       │
+ *   │  ⚖️ Decision    [Streaming]   │
+ *   │  📋 Action      [Idle]       │
+ *   ├──────────────────────────────┤
+ *   │  Blackboard 共享黑板          │
+ *   │  - 决策 / 待办 / 风险         │
+ *   ├──────────────────────────────┤
+ *   │  [模拟输入]   [一键预演]      │
+ *   │  [结束会议 → 一键生成纪要]   │
+ *   └──────────────────────────────┘
+ */
+
+import React, { useState } from 'react';
+import { Card, Button, Input, Space, Typography, Empty, Tabs, message, Tag, Tooltip } from 'antd';
+import {
+  SendOutlined,
+  PlayCircleOutlined,
+  StopOutlined,
+  BulbOutlined,
+  TeamOutlined,
+  ThunderboltOutlined,
+  FileTextOutlined,
+} from '@ant-design/icons';
+import { AgentCard } from './AgentCard';
+import { Blackboard } from './Blackboard';
+import {
+  useAllAgentRunStates,
+  useBlackboard,
+} from '@/services/useMultiAgent';
+import {
+  fanoutChunk,
+  runClosingSummary,
+  resetMeeting,
+} from '@/services/multiAgentOrchestrator';
+
+const { Text, Paragraph } = Typography;
+
+interface AgentPanelProps {
+  meetingId: string;
+  isZh: boolean;
+  onClose?: () => void;
+}
+
+export const AgentPanel: React.FC<AgentPanelProps> = ({ meetingId, isZh, onClose }) => {
+  const agents = useAllAgentRunStates();
+  const bb = useBlackboard();
+  const [speaker, setSpeaker] = useState(isZh ? '张三' : 'Alice');
+  const [content, setContent] = useState('');
+  const [activeTab, setActiveTab] = useState('agents');
+
+  // 一键喂入
+  const handleSend = async () => {
+    if (!content.trim()) {
+      message.warning(isZh ? '请输入发言内容' : 'Please enter content');
+      return;
+    }
+    const s = speaker;
+    const c = content;
+    setContent('');
+    await fanoutChunk(s, c);
+  };
+
+  // 一键结束会议 → 自动生成结构化纪要
+  const handleCloseMeeting = async () => {
+    message.loading({ content: isZh ? '正在汇总会议纪要…' : 'Generating summary…', key: 'closing' });
+    await runClosingSummary();
+    message.success({ content: isZh ? '会议纪要已生成' : 'Summary generated', key: 'closing' });
+    if (onClose) onClose();
+  };
+
+  // 模拟一段连续讨论
+  const handleSimulate = async () => {
+    const lines = isZh
+      ? [
+          { speaker: '张三', content: '今天的核心议题是 Q3 预算重新评估。' },
+          { speaker: '李四', content: '我担心现金流，需要紧急安排跨部门协调。' },
+          { speaker: '王五', content: '决定：Q3 预算方案下周确定，李四负责跟进。' },
+          { speaker: '赵六', content: '新合规要求必须月底前完成，请张三分担。' },
+          { speaker: '张三', content: '收到，我会尽快完成合规整改。' },
+        ]
+      : [
+          { speaker: 'Alice', content: "Today's core topic is Q3 budget reassessment." },
+          { speaker: 'Bob', content: 'I am concerned about cash flow. Need urgent cross-team coordination.' },
+          { speaker: 'Carol', content: 'Decided: Q3 budget plan will be finalized next week, Bob to follow up.' },
+          { speaker: 'Dave', content: 'New compliance requirements must be done by month-end, Alice to handle.' },
+          { speaker: 'Alice', content: 'Got it, I will complete compliance remediation ASAP.' },
+        ];
+    for (const l of lines) {
+      await fanoutChunk(l.speaker, l.content);
+      await new Promise((r) => setTimeout(r, 600));
+    }
+  };
+
+  // Phase 标签
+  const phaseConfig: Record<string, { color: string; text: string }> = {
+    scheduled: { color: 'default', text: isZh ? '待开始' : 'Scheduled' },
+    rehearsed: { color: 'cyan', text: isZh ? '已预演' : 'Rehearsed' },
+    in_progress: { color: 'processing', text: isZh ? '进行中' : 'In Progress' },
+    summarizing: { color: 'warning', text: isZh ? '汇总中' : 'Summarizing' },
+    actioning: { color: 'gold', text: isZh ? '派单中' : 'Actioning' },
+    closed: { color: 'success', text: isZh ? '已闭环' : 'Closed' },
+  };
+  const curPhase = phaseConfig[bb.phase];
+
+  return (
+    <div style={{ display: 'flex', flexDirection: 'column', height: '100%' }}>
+      {/* Header */}
+      <div
+        style={{
+          padding: '10px 14px',
+          borderBottom: '1px solid var(--color-border)',
+          background: 'linear-gradient(135deg, #0F2B5B11, #722ed111)',
+          display: 'flex',
+          alignItems: 'center',
+          justifyContent: 'space-between',
+        }}
+      >
+        <Space size={8}>
+          <ThunderboltOutlined style={{ color: '#722ed1', fontSize: 16 }} />
+          <Text strong style={{ fontSize: 14 }}>
+            {isZh ? '多 Agent 协作中心' : 'Multi-Agent Center'}
+          </Text>
+          <Tag color={curPhase.color}>{curPhase.text}</Tag>
+        </Space>
+        <Tooltip title={isZh ? '切换会议时重置状态' : 'Reset on meeting switch'}>
+          <Button
+            size="small"
+            type="text"
+            icon={<StopOutlined />}
+            onClick={() => {
+              resetMeeting(meetingId);
+              message.info(isZh ? '已重置' : 'Reset');
+            }}
+          />
+        </Tooltip>
+      </div>
+
+      {/* Tabs */}
+      <Tabs
+        activeKey={activeTab}
+        onChange={setActiveTab}
+        size="small"
+        style={{ flex: 1, display: 'flex', flexDirection: 'column' }}
+        items={[
+          {
+            key: 'agents',
+            label: (
+              <span>
+                <TeamOutlined />
+                {isZh ? 'Agent 状态' : 'Agents'}
+              </span>
+            ),
+            children: (
+              <div style={{ padding: '8px 10px', overflow: 'auto', flex: 1 }}>
+                <Space direction="vertical" size={8} style={{ width: '100%' }}>
+                  <AgentCard role="moderator" state={agents.moderator} isZh={isZh} compact />
+                  <AgentCard role="notetaker" state={agents.notetaker} isZh={isZh} compact />
+                  <AgentCard role="decision" state={agents.decision} isZh={isZh} compact />
+                  <AgentCard role="action" state={agents.action} isZh={isZh} compact />
+                </Space>
+              </div>
+            ),
+          },
+          {
+            key: 'blackboard',
+            label: (
+              <span>
+                <BulbOutlined />
+                {isZh ? '共享黑板' : 'Blackboard'}
+                {bb.actions.length + bb.decisions.length > 0 && (
+                  <Tag color="purple" style={{ marginLeft: 6 }}>
+                    {bb.actions.length + bb.decisions.length}
+                  </Tag>
+                )}
+              </span>
+            ),
+            children: (
+              <div style={{ padding: '8px 10px', overflow: 'auto', flex: 1 }}>
+                <Blackboard isZh={isZh} />
+              </div>
+            ),
+          },
+        ]}
+      />
+
+      {/* Input */}
+      <div
+        style={{
+          borderTop: '1px solid var(--color-border)',
+          padding: 10,
+          background: 'var(--color-bg-card)',
+        }}
+      >
+        <Space.Compact style={{ width: '100%', marginBottom: 6 }}>
+          <Input
+            value={speaker}
+            onChange={(e) => setSpeaker(e.target.value)}
+            placeholder={isZh ? '发言人' : 'Speaker'}
+            style={{ width: 90 }}
+          />
+          <Input
+            value={content}
+            onChange={(e) => setContent(e.target.value)}
+            placeholder={isZh ? '输入发言，自动触发 4 Agent 并行分析…' : 'Type a message, 4 agents analyze in parallel…'}
+            onPressEnter={handleSend}
+          />
+          <Button type="primary" icon={<SendOutlined />} onClick={handleSend}>
+            {isZh ? '发送' : 'Send'}
+          </Button>
+        </Space.Compact>
+        <Space size={6} style={{ width: '100%' }} wrap>
+          <Button
+            size="small"
+            icon={<PlayCircleOutlined />}
+            onClick={handleSimulate}
+          >
+            {isZh ? '模拟一段讨论' : 'Simulate'}
+          </Button>
+          <Button
+            size="small"
+            type="primary"
+            danger
+            icon={<FileTextOutlined />}
+            onClick={handleCloseMeeting}
+            disabled={bb.facts.length === 0}
+          >
+            {isZh ? '结束会议 → 生成纪要' : 'Close → Summary'}
+          </Button>
+        </Space>
+      </div>
+    </div>
+  );
+};
diff --git a/src/components/Meeting/Blackboard.tsx b/src/components/Meeting/Blackboard.tsx
