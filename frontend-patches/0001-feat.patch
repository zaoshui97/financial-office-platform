+/* Multi-Agent Panel Styles */
+
+@keyframes blink {
+  0%, 50% { opacity: 1; }
+  51%, 100% { opacity: 0; }
+}
+
+@keyframes flow-line {
+  0% { stroke-dashoffset: 100; }
+  100% { stroke-dashoffset: 0; }
+}
+
+.multi-agent-view {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background: var(--color-bg-card, #fff);
+  border-left: 1px solid var(--color-border);
+}
+
+.agent-card-thinking {
+  position: relative;
+  overflow: hidden;
+}
+
+.agent-card-thinking::after {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: -100%;
+  width: 100%;
+  height: 100%;
+  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
+  animation: shimmer 1.5s infinite;
+}
+
+@keyframes shimmer {
+  100% { left: 100%; }
+}
+
+.blackboard-flow-arrow {
+  fill: none;
+  stroke-width: 1.5;
+  stroke-dasharray: 4 4;
+  animation: flow-line 2s linear infinite;
+}
+
+/* Rehearsal page */
+.rehearsal-page {
+  padding: 24px;
+  background: linear-gradient(135deg, #f6f8fb 0%, #e8edf4 100%);
+  min-height: 100vh;
+}
+
+.rehearsal-timeline {
+  position: relative;
+  padding-left: 24px;
+}
+
+.rehearsal-timeline::before {
+  content: '';
+  position: absolute;
+  left: 8px;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  background: linear-gradient(180deg, #0F2B5B, #722ed1);
+}
+
+.rehearsal-step {
+  position: relative;
+  padding: 12px 0 12px 16px;
+}
+
+.rehearsal-step::before {
+  content: '';
+  position: absolute;
+  left: -20px;
+  top: 18px;
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: #fff;
+  border: 2px solid #0F2B5B;
+  z-index: 1;
+}
+
+.rehearsal-step.active::before {
+  background: #722ed1;
+  box-shadow: 0 0 0 4px rgba(114, 46, 209, 0.2);
+}
+
+.rehearsal-step.done::before {
+  background: #52c41a;
+  border-color: #52c41a;
+}
