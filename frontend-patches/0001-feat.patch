+        </div>
+
+        {/* 国际化 */}
+        <Tooltip title={t('topbar.switchLanguage')}>
+          <GlobalOutlined
+            style={{ fontSize: 18, cursor: 'pointer', color: '#4E5969' }}
+            onClick={() => handleLanguageChange(currentLang === 'zh-CN' ? 'en-US' : 'zh-CN')}
+          />
+        </Tooltip>
+
+        {/* 用户头像 - 点击打开个人中心 Drawer */}
+        <div
+          onClick={() => setProfileOpen(true)}
