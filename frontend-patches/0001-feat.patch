+      id: '2',
+      type: 'meeting',
+      title: '会议提醒',
+      content: '5 分钟后：Q4预算审批会议',
+      timestamp: new Date(Date.now() - 3 * 60 * 1000),
+      read: false,
+      action: [
+        { label: '加入会议', key: 'join' },
