diff --git a/src/pages/Dashboard/components/DashboardCharts/index.tsx b/src/pages/Dashboard/components/DashboardCharts/index.tsx
new file mode 100644
index 0000000..22d3c92
--- /dev/null
+++ b/src/pages/Dashboard/components/DashboardCharts/index.tsx
@@ -0,0 +1,324 @@
+import React, { useState } from 'react';
+import { Card, Row, Col, Typography, Space, Tag, Button, Empty, Checkbox } from 'antd';
+import {
+  CheckCircleOutlined,
+  ScheduleOutlined,
+  WarningOutlined,
+  ClockCircleOutlined,
+  RiseOutlined,
+  ArrowRightOutlined,
+} from '@ant-design/icons';
+import {
+  AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip,
+  ResponsiveContainer, LineChart, Line, Legend, ReferenceLine,
+} from 'recharts';
+import type { ActionItem } from '@/types/api';
+import './index.css';
+
+const { Text } = Typography;
+
+type StatusKey = 'todo' | 'in_progress' | 'done';
+
+// ============================================================
+// Efficiency Analysis Data
+// ============================================================
+
+/** Efficiency Analysis Chart: CFD Flow + Completed Bar + Avg Time Line */
+const efficiencyData = [
+  { day: 'Mon', pending: 18, processing: 6, completed: 4, done: 8, avgTime: 3.2 },
+  { day: 'Tue', pending: 15, processing: 8, completed: 9, done: 11, avgTime: 2.8 },
+  { day: 'Wed', pending: 12, processing: 5, completed: 15, done: 9, avgTime: 2.6 },
+  { day: 'Thu', pending: 9, processing: 7, completed: 20, done: 13, avgTime: 2.1 },
+  { day: 'Fri', pending: 6, processing: 4, completed: 26, done: 15, avgTime: 1.8 },
+  { day: 'Sat', pending: 3, processing: 2, completed: 31, done: 5, avgTime: 1.6 },
+  { day: 'Sun', pending: 1, processing: 1, completed: 34, done: 3, avgTime: 1.5 },
+];
+
+// ============================================================
+// Sub-components
+// ============================================================
+
+interface StatItem {
+  key: StatusKey;
+  icon: React.ReactNode;
+  label: string;
+  color: string;
+  tagColor: string;
+}
+
+const DashboardCharts: React.FC<DashboardChartsProps> = ({ actionItems = [], onMarkDone }) => {
+  const [activeKey, setActiveKey] = useState<StatusKey>('todo');
+  const safeItems = actionItems ?? [];
+
+  const stats: StatItem[] = [
+    { key: 'todo', icon: <WarningOutlined />, label: 'To Do', color: '#E69948', tagColor: 'warning' },
+    { key: 'in_progress', icon: <ScheduleOutlined />, label: 'In Progress', color: '#3B82F6', tagColor: 'processing' },
+    { key: 'done', icon: <CheckCircleOutlined />, label: 'Completed', color: '#22A775', tagColor: 'success' },
+  ];
+
+  const count = (key: StatusKey) =>
+    safeItems.filter((i) => i.status === key).length;
+
+  const list = safeItems.filter((i) => i.status === activeKey);
+  const statusText: Record<ActionItem['status'], string> = {
+    todo: 'To Do',
+    in_progress: 'In Progress',
+    done: 'Completed',
+  };
+
+  return (
+    <div className="dashboard-charts">
+
+      {/* Row 1: Pending Tasks (compact, single glance) */}
+      <Card
+        title={
+          <Space>
+            <ClockCircleOutlined style={{ color: '#0F2B5B' }} />
+            <span>My Pending Tasks</span>
+            <Tag color="default">Total {safeItems.length}</Tag>
+          </Space>
+        }
+        extra={
+          <Text type="secondary" style={{ fontSize: 11 }}>
+            All <ArrowRightOutlined />
+          </Text>
+        }
+        styles={{ body: { padding: 0 } }}
+      >
+        {/* Status switcher Tab */}
+        <div
+          style={{
+            display: 'grid',
+            gridTemplateColumns: 'repeat(3, 1fr)',
+            borderBottom: '1px solid #F0F2F5',
+            background: '#FAFBFC',
+          }}
+        >
+          {stats.map((item, idx) => {
+            const isActive = activeKey === item.key;
+            return (
+              <div
+                key={item.key}
+                onClick={() => setActiveKey(item.key)}
+                style={{
+                  display: 'flex',
+                  alignItems: 'center',
+                  gap: 10,
+                  padding: '10px 14px',
+                  cursor: 'pointer',
+                  borderRight: idx < stats.length - 1 ? '1px solid #F0F2F5' : 'none',
+                  borderBottom: isActive ? `2px solid ${item.color}` : '2px solid transparent',
+                  background: isActive ? '#fff' : 'transparent',
+                  transition: 'all 0.2s',
+                }}
+                onMouseEnter={(e) => (e.currentTarget.style.background = isActive ? '#fff' : `${item.color}08`)}
+                onMouseLeave={(e) => (e.currentTarget.style.background = isActive ? '#fff' : 'transparent')}
+              >
+                <div
+                  style={{
+                    width: 28, height: 28, borderRadius: 6,
+                    background: `${item.color}15`, color: item.color,
+                    display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 14,
+                  }}
+                >
+                  {item.icon}
+                </div>
+                <div style={{ flex: 1 }}>
+                  <Text style={{ fontSize: 12, color: '#4E5969' }}>{item.label}</Text>
+                </div>
+                <Text strong style={{ fontSize: 18, color: item.color, lineHeight: 1 }}>
+                  {count(item.key)}
+                </Text>
+              </div>
+            );
+          })}
+        </div>
+
+        {/* Pending list */}
+        <div style={{ padding: list.length === 0 ? '14px 0' : '0' }}>
+          {list.length === 0 ? (
+            <Empty
+              description={
+                <Text type="secondary" style={{ fontSize: 12 }}>
+                  No {stats.find((s) => s.key === activeKey)?.label} tasks
+                </Text>
+              }
+              imageStyle={{ height: 36 }}
+              style={{ padding: '14px 0' }}
+            />
+          ) : (
+            list.map((item) => {
+              const cfg = stats.find((s) => s.key === item.status)!;
+              const isDone = item.status === 'done';
+              return (
+                <div
+                  key={item.id}
+                  style={{
+                    display: 'flex',
+                    alignItems: 'center',
+                    gap: 10,
+                    padding: '8px 16px',
+                    borderBottom: '1px solid #F5F7FA',
+                    transition: 'background 0.2s',
+                  }}
+                  onMouseEnter={(e) => (e.currentTarget.style.background = '#FAFBFC')}
+                  onMouseLeave={(e) => (e.currentTarget.style.background = 'transparent')}
+                >
+                  <div
+                    style={{
+                      width: 6, height: 6, borderRadius: '50%',
+                      background: cfg.color, flexShrink: 0,
+                    }}
+                  />
+                  <Text
+                    style={{
+                      flex: 1, fontSize: 13,
+                      color: isDone ? '#8A94A6' : '#1a1a2e',
+                      textDecoration: isDone ? 'line-through' : 'none',
+                    }}
+                    ellipsis
+                  >
+                    {item.description}
+                  </Text>
+                  <Space size={8} style={{ flexShrink: 0 }}>
+                    <Text type="secondary" style={{ fontSize: 11 }}>
+                      {item.assigneeName}
+                    </Text>
+                    <Tag color={cfg.tagColor} style={{ margin: 0, fontSize: 10, lineHeight: '16px', padding: '0 6px' }}>
+                      {statusText[item.status]}
+                    </Tag>
+                    {!isDone && onMarkDone && (
+                      <Button
+                        type="text"
+                        size="small"
+                        icon={<CheckCircleOutlined />}
+                        onClick={(e) => {
+                          e.stopPropagation();
+                          onMarkDone(item);
+                        }}
+                        style={{ color: '#22A775' }}
+                      />
+                    )}
+                  </Space>
+                </div>
+              );
+            })
+          )}
+        </div>
+      </Card>
+
+      {/* Row 2: Efficiency Analysis (single chart) */}
+      <Card
+        title={
+          <Space>
+            <RiseOutlined style={{ color: '#0F2B5B' }} />
+            <span>Efficiency Analysis</span>
+            <Tag color="success">Last 7 days - 42% improvement</Tag>
+          </Space>
+        }
+        styles={{ body: { padding: '12px 8px 4px' } }}
+        style={{ marginTop: 12 }}
+      >
+        <ResponsiveContainer width="100%" height={260}>
+          <AreaChart data={efficiencyData} margin={{ top: 5, right: 24, left: 0, bottom: 5 }}>
+            <defs>
+              <linearGradient id="gradPending" x1="0" y1="0" x2="0" y2="1">
+                <stop offset="5%" stopColor="#E69948" stopOpacity={0.3} />
+                <stop offset="95%" stopColor="#E69948" stopOpacity={0.02} />
+              </linearGradient>
+              <linearGradient id="gradProcessing" x1="0" y1="0" x2="0" y2="1">
+                <stop offset="5%" stopColor="#3B82F6" stopOpacity={0.3} />
+                <stop offset="95%" stopColor="#3B82F6" stopOpacity={0.02} />
+              </linearGradient>
+              <linearGradient id="gradDone" x1="0" y1="0" x2="0" y2="1">
+                <stop offset="5%" stopColor="#22A775" stopOpacity={0.3} />
+                <stop offset="95%" stopColor="#22A775" stopOpacity={0.02} />
+              </linearGradient>
+            </defs>
+            <CartesianGrid strokeDasharray="3 3" stroke="#F0F2F5" vertical={false} />
+            <XAxis dataKey="day" tick={{ fontSize: 11, fill: '#8A94A6' }} axisLine={false} tickLine={false} />
+            <YAxis
+              yAxisId="left"
+              tick={{ fontSize: 11, fill: '#8A94A6' }} axisLine={false} tickLine={false}
+              label={{ value: 'Task Count', angle: -90, position: 'insideLeft', style: { fontSize: 10, fill: '#8A94A6' } }}
+            />
+            <YAxis
+              yAxisId="right" orientation="right"
+              tick={{ fontSize: 11, fill: '#8A94A6' }} axisLine={false} tickLine={false} unit="h"
+              label={{ value: 'Time (h)', angle: 90, position: 'insideRight', style: { fontSize: 10, fill: '#8A94A6' } }}
+            />
+            <Tooltip
+              contentStyle={{
+                border: '1px solid #E8EDF4', borderRadius: 8,
+                boxShadow: '0 4px 12px rgba(0,0,0,0.08)',
+              }}
+              labelStyle={{ fontSize: 12, color: '#0F2B5B', fontWeight: 600 }}
+            />
+            <Legend
+              iconType="circle" iconSize={8}
+              wrapperStyle={{ paddingBottom: 4 }}
+              formatter={(value) => <span style={{ fontSize: 11, color: '#4E5969' }}>{value}</span>}
+            />
+            {/* CFD Stack Flow */}
+            <Area yAxisId="left" type="monotone" dataKey="completed" stackId="cfd" stroke="#22A775" fill="url(#gradDone)" strokeWidth={2} />
+            <Area yAxisId="left" type="monotone" dataKey="processing" stackId="cfd" stroke="#3B82F6" fill="url(#gradProcessing)" strokeWidth={2} />
+            <Area yAxisId="left" type="monotone" dataKey="pending" stackId="cfd" stroke="#E69948" fill="url(#gradPending)" strokeWidth={2} />
+            {/* Avg Time Line */}
+            <Line
+              yAxisId="right" type="monotone" dataKey="avgTime"
+              stroke="#0F2B5B" strokeWidth={2} strokeDasharray="5 3"
+              dot={{ r: 3, fill: '#0F2B5B' }} activeDot={{ r: 5 }}
+              name="Avg Time (h)"
+            />
+            {/* AI Baseline Reference Line */}
+            <ReferenceLine
+              yAxisId="right" y={5.0}
+              stroke="#C8CED7" strokeDasharray="2 2"
+              label={{ value: 'AI Baseline: 5.0h', position: 'insideTopRight', fill: '#C8CED7', fontSize: 10 }}
+            />
+          </AreaChart>
+        </ResponsiveContainer>
+
+        {/* KPI Mini Cards */}
+        <div style={{
+          display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)',
+          gap: 8, padding: '8px 8px 4px', borderTop: '1px dashed #F0F2F5', marginTop: 4,
+        }}>
+          <KpiMini label="Tasks Completed" value="64" unit="" color="#22A775" />
+          <KpiMini label="AI Processing" value="78" unit="%" color="#3B82F6" />
+          <KpiMini label="Avg Time" value="2.2" unit="h" color="#E69948" sub="vs baseline 5.0h" />
+          <KpiMini label="Efficiency Gain" value="+42" unit="%" color="#0F2B5B" sub="vs last week" />
+        </div>
+      </Card>
+    </div>
+  );
+};
+
+// ============================================================
+// KPI Mini Card
