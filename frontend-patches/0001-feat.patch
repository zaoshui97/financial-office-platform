+                          {ref.excerpt}
+                        </div>
+                        <div style={{ color: '#9ca3af', fontSize: 11, marginTop: 4 }}>
+                          {ref.source}
+                        </div>
+                      </div>
+                    ))}
+                  </div>
+                )}
+
+                {/* 操作栏 */}
+                {msg.role === 'assistant' && !msg.typing && (
+                  <div style={{ marginTop: 8, display: 'flex', gap: 4, alignItems: 'center' }}>
