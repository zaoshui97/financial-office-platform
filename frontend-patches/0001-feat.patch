+
+  const generateMockResponse = (input: string) => {
+    const lowerInput = input.toLowerCase();
+
+    if (lowerInput.includes('hello') || lowerInput.includes('hi')) {
+      return { content: 'Hello! How can I assist you today? I can help with financial data, compliance questions, meeting minutes, and more.', references: [] };
