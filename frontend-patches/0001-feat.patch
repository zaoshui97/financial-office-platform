+      ],
+    },
+  ]);
+
+  const getTimeAgo = (date: Date): string => {
+    const now = new Date();
+    const diff = now.getTime() - date.getTime();
+    const minutes = Math.floor(diff / 60000);
+    const hours = Math.floor(diff / 3600000);
+    const days = Math.floor(diff / 86400000);
+
+    if (minutes < 1) return t('common.justNow');
+    if (minutes < 60) return t('common.minutesAgo', { count: minutes });
+    if (hours < 24) return t('common.hoursAgo', { count: hours });
+    return t('common.daysAgo', { count: days });
+  };
+
+  const getTypeIcon = (type: Notification['type']) => {
+    switch (type) {
+      case 'urgent':
+        return <ExclamationCircleOutlined style={{ color: '#D64045' }} />;
+      case 'meeting':
+        return <CalendarOutlined style={{ color: '#3B82F6' }} />;
+      case 'ai':
+        return <RobotOutlined style={{ color: '#C9A459' }} />;
+      case 'system':
+        return <FileTextOutlined style={{ color: '#8B949E' }} />;
+    }
+  };
+
+  const getTypeTag = (type: Notification['type']) => {
+    const config = {
+      urgent: { color: 'red', text: t('notification.urgent') },
+      meeting: { color: 'blue', text: t('notification.meeting') },
+      ai: { color: 'gold', text: t('notification.ai') },
+      system: { color: 'default', text: t('notification.system') },
+    };
+    const { color, text } = config[type];
