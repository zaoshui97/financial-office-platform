# Copy this file to .env.deploy and replace every CHANGE_ME value locally.
# Never commit .env.deploy.

API_IMAGE_TAG=local
API_HOST_PORT=8000

MYSQL_DATABASE=financial_office
MYSQL_USER=financial_office
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost"]
DATABASE_WAIT_TIMEOUT_SECONDS=120

QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge_qwen3_7_text_embedding_v1_1024
QDRANT_TIMEOUT_SECONDS=10

PDF_OCR_DPI=300
PDF_OCR_MIN_NATIVE_TEXT_CHARS=20
PDF_OCR_MAX_PAGES=30
PDF_OCR_PAGE_TIMEOUT_SECONDS=30
PDF_OCR_DOCUMENT_TIMEOUT_SECONDS=180
PDF_OCR_MAX_CONCURRENCY=1

EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_VERSION=v1
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=0

QWEN_API_KEY=CHANGE_ME
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_MODEL=CHANGE_ME

DOUBAO_API_KEY=CHANGE_ME
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=CHANGE_ME

# Legacy openai_compatible compatibility settings only. The built-in RAG router
# uses QWEN_API_KEY and falls back to DEEPSEEK_API_KEY; do not reuse either key here.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=
AI_SDK_MAX_RETRIES=0
AI_MAX_RETRIES=0
AI_FALLBACK_ENABLED=true
