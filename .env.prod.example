# .env.prod.example — 生产环境变量模板
#
# 拷贝： cp .env.prod.example .env.prod
# 1) 把所有 ???? 替换为 openssl rand -hex 32 生成的值
# 2) 部署到生产前用 secret manager 注入（K8s Secret / ACM / 阿里云 KMS 等）
# 3) 任何包含密码/密钥的 .env.prod 严禁提交到 git（已加进 .gitignore）

# ============== 基础 ==============
APP_NAME=金融智能办公平台
APP_ENV=production
DEBUG=false

# ============== MySQL ==============
# docker-compose.prod.yml 用这套变量
MYSQL_ROOT_PASSWORD=change-me-32-bytes-hex
MYSQL_USER=finuser
MYSQL_PASSWORD=change-me-32-bytes-hex
MYSQL_DATABASE=financial_office

# 应用直连（容器内用 service name）
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=${MYSQL_USER}
DATABASE_PASSWORD=${MYSQL_PASSWORD}
DATABASE_NAME=${MYSQL_DATABASE}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============== Redis ==============
REDIS_URL=redis://redis:6379/0

# ============== Qdrant ==============
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ============== JWT ==============
# 必须用强随机；长度 ≥ 32 字符
SECRET_KEY=change-me-32-bytes-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token 单独密钥（与 ACCESS 不同）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============== CORS ==============
# 前端域名（用反代 / 边缘路由后的真实外网域名）
BACKEND_CORS_ORIGINS=["https://your-domain.com"]

# ============== AI Providers ==============
# 至少配一家（推荐：豆包 + Qwen 双 provider 互为 fallback）
DOUBAO_API_KEY=your-ark-api-key
DOUBAO_MODEL=doubao-seed-2-1-pro

QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-reasoner

# ============== Embedding ==============
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============== API 启动 ==============
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_V1_PREFIX=/api/v1

# 启动选项
RUN_MIGRATIONS_ON_START=true
WAIT_FOR_DB=true
DB_WAIT_TIMEOUT=120
DATABASE_CHECK_ON_STARTUP=false

# ============== 日志 ==============
LOG_LEVEL=INFO
LOG_DIR=/srv/app/logs

# ============== 沙箱 ==============
# 严格模式：拦截 / 记录 / 不放行
SANDBOX_STRICT_MODE=true
SANDBOX_LLM_JUDGE_ENABLED=true
SANDBOX_LLM_JUDGE_PROVIDER=
SANDBOX_LLM_JUDGE_CONFIDENCE_THRESHOLD=0.7

# ============== 健康检查 ==============
# /api/v1/system/health/live 不依赖 DB；/ready 依赖 DB
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s

# ============== 镜像 tag（CI/CD 用） ==============
API_IMAGE_TAG=v1.0.0
FRONTEND_IMAGE_TAG=v1.0.0
