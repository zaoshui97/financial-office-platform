# 应用基础配置
APP_NAME=金融企业智能办公平台
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_CHECK_ON_STARTUP=false

# MySQL配置
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=change-me
DATABASE_NAME=financial_office
DATABASE_CHARSET=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis配置，Phase 1暂不使用业务缓存
REDIS_URL=redis://127.0.0.1:6379/0

# JWT配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 日志与跨域配置
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON_FILE=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# CORS_ORIGINS 开发环境放行 5173（Vite 默认端口）与 3000/8080；生产请收紧到正式域名
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
# RAG document storage
STORAGE_DIR=storage/uploads
RAG_MAX_FILE_SIZE_MB=20

# 扫描PDF本地OCR回退，默认关闭；需要单独安装Tesseract和对应语言包
PDF_OCR_ENABLED=false
PDF_OCR_EXECUTABLE=tesseract
PDF_OCR_LANGUAGES=chi_sim+eng
PDF_OCR_DPI=300
PDF_OCR_MIN_NATIVE_TEXT_CHARS=20
PDF_OCR_MAX_PAGES=30
PDF_OCR_PAGE_TIMEOUT_SECONDS=30
PDF_OCR_DOCUMENT_TIMEOUT_SECONDS=180
PDF_OCR_MAX_CONCURRENCY=1

# Qdrant vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge
QDRANT_TIMEOUT_SECONDS=10

# Vector RAG is opt-in until Embedding and Qdrant connectivity are verified.
RAG_INDEX_ENABLED=false
RAG_VECTOR_SEARCH_ENABLED=false
RAG_VECTOR_FALLBACK_TO_KEYWORD=true
RAG_VECTOR_TOP_K=20
RAG_VECTOR_TOP_N=6
# Applied after active-index/security validation and before title-aware Top-N selection.
RAG_VECTOR_SCORE_THRESHOLD=0.45
EMBEDDING_VERSION=v1

# AI provider: openai_compatible or ark
AI_PROVIDER=openai_compatible
AI_API_STYLE=chat_completions

# Volcengine Ark Responses API
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI-compatible model API
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_RAG_MODEL=
AI_WEB_SEARCH_MODEL=
AI_DOCUMENT_MODEL=
AI_SUMMARY_MODEL=
AI_MEETING_MODEL=
AI_AGENT_MODEL=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_WEB_SEARCH_MAX_KEYWORD=2
AI_TIMEOUT_SECONDS=60
AI_SDK_MAX_RETRIES=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-reasoner
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Embedding配置：默认使用阿里云百炼OpenAI Compatible接口
# EMBEDDING_API_KEY为空时复用QWEN_API_KEY
EMBEDDING_PROVIDER=bailian
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_TRUST_ENV=false
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.2
EMBEDDING_MAX_TEXT_CHARS=12000

AI_PROVIDERS_JSON=
AI_MODEL_PROFILES_JSON=
AI_TASK_ROUTES_JSON=
AI_FALLBACK_ENABLED=true
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.2
AI_LOG_PROMPTS=false

# Chat assistant
CHAT_HISTORY_LIMIT=12
CHAT_RAG_TOP_K=4
CHAT_RAG_CHUNK_SIZE=1000
CHAT_RAG_CHUNK_OVERLAP=150
CHAT_RAG_MAX_DOCUMENTS=50

# ========== 合规沙箱 LLM (0.3) ==========
SANDBOX_MODE_ENABLED=true
# Provider 白名单；留空则仅校验 base_url 是否在内网段（无默认 Provider）
SANDBOX_PROVIDER_WHITELIST=[]
# 内网 base_url 后缀白名单
SANDBOX_BASE_URL_INTERNAL_SUFFIXES=[".hengsheng.com",".internal.hengsheng.com"]
# 风险词检测（逗号分隔）
SANDBOX_RISK_KEYWORDS=洗钱,恐怖融资,内幕交易
# 降级策略：strict=完全不可用，allow=降级到普通 LLM
SANDBOX_DEGRADATION_POLICY=strict
